    "astro": "^7.1.3",
    "astro-embed": "^0.13.1",
    "astro-expressive-code": "^0.44.1",
    "astro-icon": "^1.1.5",
    "astro-lilypond": "^0.12.0",
    "astro-mermaid": "^2.1.0",
    "astro-seo": "^1.1.0",
    "element-plus": "^2.14.3",
    "hastscript": "^9.0.1",
    "katex": "^0.18.1",
