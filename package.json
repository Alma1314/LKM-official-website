{
  "name": "lkm-official-website",
  "version": "1.0.0-beta.63",
  "description": "LiKeMi Official Website",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:clean": "node -e \"require('fs').rmSync('node_modules/.vite',{recursive:true,force:true})\" && astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/precompress.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "pnpm run check:astro && pnpm run check:eslint && pnpm run check:prettier",
    "check:astro": "astro check",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "fix": "pnpm run fix:eslint && pnpm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:security": "vitest run --project security",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "dev:packages": "pnpm -r --parallel --filter \"./packages/*\" dev",
    "typecheck": "pnpm run check:astro",
    "lint": "eslint src packages scripts",
    "format:check": "prettier --check .",
    "test:smoke": "playwright test --project=chromium routes.spec.ts",
    "test:a11y": "playwright test --project=chromium accessibility.spec.ts",
    "check:seo": "node scripts/check-seo-output.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "check:browser-security": "node scripts/check-browser-security.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@astrojs/vue": "^7.0.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@expressive-code/core": "^0.44.1",
    "@expressive-code/plugin-collapsible-sections": "^0.44.1",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
