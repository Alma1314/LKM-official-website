    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-directive-rehype": "^1.0.0",
    "remark-github-admonitions-to-directives": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-sectionize": "^2.1.0",
    "sanitize-html": "^2.17.6",
    "stylus": "^0.64.0",
    "svelte": "^5.56.7",
    "three": "0.185.1",
    "unist-util-visit": "^5.1.0",
    "unpic": "^4.2.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
