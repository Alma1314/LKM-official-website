---
// src/lib/errors/ErrorBoundary.astro
interface Props {
  fallbackTitle?: string;
  fallbackMessage?: string;
}

const { fallbackTitle = '页面加载出错', fallbackMessage = '请刷新页面重试' } = Astro.props;
---

<div class="error-boundary flex min-h-[400px] flex-col items-center justify-center p-8 text-center">
  <div class="rounded-lg border border-red-200 bg-red-50 p-8 dark:border-red-800 dark:bg-red-950">
    <h2 class="mb-2 text-xl font-semibold text-red-800 dark:text-red-200">{fallbackTitle}</h2>
    <p class="text-red-600 dark:text-red-300">{fallbackMessage}</p>
    <button
      class="mt-4 rounded bg-red-600 dark:bg-red-800 px-4 py-2 text-white hover:bg-red-700 dark:hover:bg-red-700"
      onclick="window.location.reload()"
    >
      刷新页面
    </button>
  </div>
</div>
