---
import Layout from '~/layouts/BaseLayout.astro';
import BottlePage from '~/features/anonymous-letter/pages/BottlePage.vue';
import '~/features/anonymous-letter/styles/global.css';
import { allMenuItems } from '~/features/shell/menus';
import { filterNavbarByNames } from '~/lib/navigation';
import type { MetaData } from '~/types/core';
const metadata: MetaData = { title: '漂流瓶 — 拾光树洞', description: '把心事装进瓶子，交给海流，等一个陌生的回应。' };
---

<Layout metadata={metadata} navbarLinks={filterNavbarByNames(allMenuItems, ['社区主页', '博客', '资源', '我的'])}
  ><div style="min-height: 400px"><BottlePage client:only="vue" /></div></Layout
>

<script is:inline>
  (function () {
    const theme = localStorage.theme;
    const isDark = theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.classList.toggle('dark', isDark);
    const hue = localStorage.getItem('hue');
    if (hue) document.documentElement.style.setProperty('--hue', hue);
  })();
</script>
