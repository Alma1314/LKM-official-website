---
import Layout from '~/layouts/CommunitySidebarLayout.astro';
import { Icon } from 'astro-icon/components';
import { getRootCategories, getChildCategories } from '~/features/forum/data/categories';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
import { getPermalink } from '~/lib/utils/permalinks';

const metadata = { title: '板块广场 —— 理科迷' };
const rootCategories = getRootCategories();

// 每类子分类的网格列数
function gridCols(count: number): string {
  if (count <= 3) return 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3';
  return 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4';
}
---

<Layout
  metadata={metadata}
  sidebarLinks={communitySidebarLinks}
  currentPath={getPermalink('/forum')}
  navItems={['社区主页', '博客', '资源', '我的']}
>
  <div class="space-y-10">
    <div>
      <h1 class="text-3xl font-bold text-deep-text">板块广场</h1>
      <p class="text-text-muted mt-2">选择一个感兴趣的板块，加入讨论吧！</p>
    </div>

    {
      rootCategories.map((root) => {
        const children = getChildCategories(root.id);
        const showChildren = children.length > 0;

        return (
          <section id={root.slug}>
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                <Icon name={root.icon} class="w-6 h-6 text-primary" />
              </div>
              <div>
                <h2 class="text-xl font-bold text-deep-text">{root.name}</h2>
                <p class="text-sm text-text-muted">
                  {root.memberCount} 成员 · {root.postCount} 帖子 · 今日 {root.todayPostCount}
                </p>
              </div>
              <a
                href={getPermalink(`/forum/${root.slug}`)}
                class="ml-auto text-sm text-primary hover:underline whitespace-nowrap shrink-0"
              >
                查看全部 →
              </a>
            </div>

            {showChildren ? (
              <div class:list={['grid gap-4', gridCols(children.length)]}>
                {children.map((child) => (
                  <a href={getPermalink(`/forum/${child.slug}`)} class="profile-card group">
                    <div class="profile-inner p-4 flex flex-col gap-2 h-full">
                      <div class="flex items-center gap-2">
                        <Icon name={child.icon} class="w-5 h-5 text-primary shrink-0" />
                        <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">
                          {child.name}
                        </h3>
                      </div>
                      <p class="text-xs text-text-muted line-clamp-2 leading-relaxed flex-1">{child.description}</p>
                      <div class="flex items-center justify-between text-xs text-text-muted/60 pt-1 border-t border-surface-3">
                        <span>{child.memberCount} 成员</span>
                        <span>{child.postCount} 帖</span>
                        <span class="text-primary/80">
                          {child.todayPostCount > 0 ? `今日 ${child.todayPostCount}` : ''}
                        </span>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            ) : (
              <div class="bg-card-bg border border-surface-3 rounded-xl p-8 text-center">
                <p class="text-text-muted text-sm mb-2">{root.description}</p>
                {root.slug === 'school-club' && (
                  <a
                    href={getPermalink('/contact')}
                    class="inline-flex items-center gap-1 text-primary text-sm font-medium hover:underline"
                  >
                    <Icon name="tabler:plus" class="w-4 h-4" />
                    申请合作，开启你的社团板块
                  </a>
                )}
              </div>
            )}
          </section>
        );
      })
    }
  </div>
</Layout>
