---
import Layout from '~/layouts/CommunityLayout.astro';
import { Icon } from 'astro-icon/components';
import { getFileById } from '~/features/file-library/data/mock-files';
import { getPermalink } from '~/lib/utils/permalinks';

// server 模式：params 从 URL 直接解析
// 后端就绪后切换为：const file = await fileLibraryApi.getFile(fileId)
const { fileId } = Astro.params;
const file = getFileById(fileId || '');

if (!file) {
  return Astro.redirect(getPermalink('/files'));
}

function formatSize(bytes: number): string {
  if (bytes >= 1048576) return `${(bytes / 1048576).toFixed(1)} MB`;
  if (bytes >= 1024) return `${(bytes / 1024).toFixed(0)} KB`;
  return `${bytes} B`;
}

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}

function fileIcon(mime: string): string {
  if (mime === 'application/pdf') return '📄';
  if (mime === 'application/zip') return '📦';
  return '📁';
}

function statusLabel(status: string): string {
  switch (status) {
    case 'approved':
      return '已通过';
    case 'pending':
      return '审核中';
    case 'rejected':
      return '已驳回';
    default:
      return status;
  }
}

function _statusColor(status: string): string {
  switch (status) {
    case 'approved':
      return 'text-green-500 bg-green-50 dark:bg-green-950/20';
    case 'pending':
      return 'text-yellow-500 bg-yellow-50 dark:bg-yellow-950/20';
    case 'rejected':
      return 'text-red-500 bg-red-50 dark:bg-red-950/20';
    default:
      return '';
  }
}

const metadata = { title: `${file.originalName} —— 理科迷` };
---

<Layout metadata={metadata}>
  <div class="space-y-6">
    <!-- 面包屑 -->
    <div class="flex items-center gap-2 text-sm text-text-muted/60">
      <a href={getPermalink('/files')} class="hover:text-primary transition-colors">文件库</a>
      <Icon name="tabler:chevron-right" class="w-3.5 h-3.5" />
      <span class="text-text-muted truncate">{file.originalName}</span>
    </div>

    <!-- 预览区 -->
    <div class="bg-card-bg border border-surface-3 rounded-2xl p-8 text-center">
      <span class="text-6xl">{fileIcon(file.mimeType)}</span>
      <h1 class="text-xl font-bold text-deep-text mt-4">{file.originalName}</h1>
      <p class="text-sm text-text-muted mt-2">{file.description}</p>
    </div>

    <!-- 文件信息 -->
    <div class="bg-card-bg border border-surface-3 rounded-2xl p-6">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm">
        <div>
          <span class="text-text-muted/60">上传者</span><p class="text-deep-text font-medium mt-0.5">
            {file.uploaderName}
          </p>
        </div>
        <div>
          <span class="text-text-muted/60">文件大小</span><p class="text-deep-text font-medium mt-0.5">
            {formatSize(file.size)}
          </p>
        </div>
        <div>
          <span class="text-text-muted/60">上传时间</span><p class="text-deep-text font-medium mt-0.5">
            {formatDate(file.createdAt)}
          </p>
        </div>
        <div>
          <span class="text-text-muted/60">下载量</span><p class="text-deep-text font-medium mt-0.5">
            {file.downloadCount} 次
          </p>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-3 mt-4 pt-4 border-t border-surface-3">
        <span class="text-sm text-text-muted/60">状态：</span>
        <span class="text-xs px-2.5 py-1 rounded-full font-medium {_statusColor(file.status)}"
          >{statusLabel(file.status)}</span
        >
        <span class="text-sm text-text-muted/60">分类：{file.categoryName}</span>
        <div class="flex flex-wrap gap-1">
          {
            file.tags.map((tag) => (
              <span class="text-xs px-2 py-0.5 rounded-full bg-surface-3 text-text-muted">{tag}</span>
            ))
          }
        </div>
      </div>
      {
        file.reviewComment && (
          <div class="mt-3 px-3 py-2 bg-surface-3/50 rounded-lg text-sm text-text-muted">
            审核意见：{file.reviewComment}
          </div>
        )
      }
      <div class="flex gap-3 mt-4">
        <button class="btn-primary px-6 py-2.5 rounded-lg text-sm font-semibold inline-flex items-center gap-2">
          <Icon name="tabler:download" class="w-4 h-4" />
          下载文件（贡献积分 +5）
        </button>
      </div>
    </div>

    <!-- 版权免责 -->
    <div
      class="bg-yellow-50 dark:bg-yellow-950/20 border border-yellow-200 dark:border-yellow-800/30 rounded-xl p-4 text-sm text-yellow-800 dark:text-yellow-200 leading-relaxed"
    >
      <strong>免责声明：</strong
      >所有内容均为网友上传，如涉嫌侵犯您的权利，请通过举报或报告问题投诉功能发送通知，平台将及时处理。
    </div>
  </div>
</Layout>
