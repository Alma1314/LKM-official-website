---
import Layout from '~/layouts/CommunitySidebarLayout.astro';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
import QuestionBank from '~/features/competition/components/QuestionBank.vue';
import { getPermalink } from '~/core/utils/permalinks';

const metadata = { title: '题库中心 —— 理科迷' };
---

<Layout metadata={metadata} sidebarLinks={communitySidebarLinks} currentPath={getPermalink('/competition/bank')}>
  <div class="space-y-6">
    <h1 class="text-3xl font-bold text-deep-text">题库中心</h1>
    <div style="min-height: 400px"><QuestionBank client:only="vue" /></div>
  </div>
</Layout>
