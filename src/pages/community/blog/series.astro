---
import CommunityLayout from '~/layouts/CommunityLayout.astro';
import BlogApp from '~/features/blog-community/BlogApp.vue';

// Static fallback entry for /community/blog/series and subpaths.
// Since output: 'static' cannot enumerate runtime series IDs,
// direct URLs to /community/blog/series/<id> require a web server
// SPA fallback or a prerender list. This page handles the base
// /community/blog/series path.
const initialPath = Astro.url.pathname;
---

<CommunityLayout>
  <BlogApp client:only="vue" initialPath={initialPath} />
</CommunityLayout>
