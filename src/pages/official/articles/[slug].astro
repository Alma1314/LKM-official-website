---
import Layout from '~/layouts/OfficialSidebarLayout.astro';
import ArticleSingle from '~/features/official-articles/components/ArticleSingle.astro';
import RelatedPosts from '~/features/official-articles/components/RelatedPosts.astro';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
import { getPermalink } from '~/lib/utils/permalinks';
import { ssrFetch, logSsrError } from '~/lib/fetch-ssr';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import { fetchAllArticles, type ArticleDetail } from '~/lib/api';
import { t } from '~/lib/i18n';

const { slug } = Astro.params as { slug: string };

const { data: article, error } = await ssrFetch<ArticleDetail>(`/api/v1/articles/${slug}`, {
  fallback: null,
});
logSsrError(`文章详情 ${slug}`, error);

if (error || !article) {
  return new Response(
    `<div class="max-w-2xl mx-auto py-20 text-center">
      <h1 class="text-2xl font-bold text-deep-text mb-2">${t('page.articles.notFound')}</h1>
      <p class="text-text-muted mb-4">${error || t('page.articles.notExist')}</p>
      <a href="${getPermalink('/official/articles')}" class="text-primary hover:underline">${t('page.articles.backToList')}</a>
    </div>`,
    { status: 404, headers: { 'Content-Type': 'text/html' } }
  );
}

const processor = await createMarkdownProcessor();
const rendered = await processor.render(article.content);
const headings = rendered.metadata.headings;

const { articles: allArticles } = await fetchAllArticles();

const metadata = { title: `${article.title} —— LKM` };
---

<Layout
  metadata={metadata}
  sidebarLinks={communitySidebarLinks}
  currentPath={getPermalink(`/official/articles/${slug}`)}
  showFooter={false}
  navItems={['主页', '新闻资讯', '寻求帮助', '七月团队', '资源']}
>
  <div class="space-y-6">
    <a href={getPermalink('/official/articles')} class="text-sm text-text-muted hover:text-primary transition-colors">
      &larr; {t('page.articles.backToList')}
    </a>

    <ArticleSingle article={article} headings={headings}>
      <Fragment set:html={rendered.code} />
    </ArticleSingle>

    <RelatedPosts articles={allArticles} currentSlug={article.slug} currentCategory={article.category} />
  </div>
</Layout>
