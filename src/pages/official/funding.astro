---
import Layout from '~/layouts/OfficialLayout.astro';
import { t } from '~/lib/i18n';

const metadata = { title: t('page.official.funding.metaTitle') };
---

<Layout metadata={metadata} navItems={['nav.home', 'nav.news', 'nav.team', 'nav.resources']}>
  <div class="max-w-2xl mx-auto text-center py-12">
    <!-- 插画区 -->
    <div class="mb-8">
      <div class="w-32 h-32 mx-auto rounded-full bg-primary/5 flex items-center justify-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="64"
          height="64"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-primary/40"
        >
          <path
            d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
          ></path>
        </svg>
      </div>
    </div>

    <h1 class="text-3xl font-bold text-deep-text mb-3">{t('page.official.funding.heading')}</h1>

    <p class="text-text-muted mb-8 max-w-md mx-auto leading-relaxed">
      {t('page.official.funding.sustainableLine')}<br />
      {t('page.official.funding.selfFundedLine')}<br />
      {t('page.official.funding.planLine')}
    </p>

    <div class="bg-card-bg border border-surface-3 rounded-xl p-6 mb-8 max-w-md mx-auto text-left text-sm">
      <h3 class="font-semibold text-deep-text mb-2">{t('page.official.funding.costsTitle')}</h3>
      <ul class="space-y-2 text-text-muted">
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-primary/50 shrink-0"></span>{t('page.official.funding.serverDomain')}
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-primary/50 shrink-0"></span>{t('page.official.funding.storageCdn')}
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-primary/50 shrink-0"></span>{t('page.official.funding.smsEmail')}
        </li>
      </ul>
    </div>

    <div
      class="bg-amber-50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-800/30 rounded-xl p-5 max-w-md mx-auto text-sm"
    >
      <p class="text-amber-800 dark:text-amber-200 leading-relaxed">
        <strong>{t('page.official.funding.thanksTitle')}</strong><br />
        {t('page.official.funding.transparencyNote')}
      </p>
    </div>

    <button
      class="mt-8 btn-primary px-8 py-3 rounded-xl text-base font-semibold opacity-50 cursor-not-allowed"
      disabled
    >
      {t('page.official.funding.notOpen')}
    </button>
  </div>
</Layout>
