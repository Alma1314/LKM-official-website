---
import Layout from '~/layouts/OfficialSidebarLayout.astro';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
import AskFormPage from '~/features/qa/components/AskFormPage.vue';
import { getPermalink } from '~/lib/utils/permalinks';

const metadata = { title: '提出问题 —— 理科迷' };
---

<Layout metadata={metadata} sidebarLinks={communitySidebarLinks} currentPath={getPermalink('/qa/ask')} navItems={['主页','新闻资讯','寻求帮助','七月团队','资源']}>
  <div style="min-height: 400px"><AskFormPage client:only="vue" /></div>
</Layout>
