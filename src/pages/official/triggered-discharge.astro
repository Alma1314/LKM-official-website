---
import Layout from '~/layouts/BaseLayout.astro';
import type { MetaData } from '~/types/core';
import { buildUrl } from '~/lib/utils/paths';
import { t } from '~/lib/i18n';

const metadata: MetaData = {
  title: t('page.official.triggeredDischarge.metaTitle'),
  description: t('page.official.triggeredDischarge.metaDescription'),
};
---

<Layout metadata={metadata}>
  <!-- 全屏覆盖：独立运行环境，不受页面布局影响 -->
  <div id="td-root" style="position:fixed; inset:0; z-index:9999; background:#030408; overflow:hidden;">
    <canvas
      id="td-gpu"
      style="position:fixed; inset:0; width:100%; height:100%; display:block; touch-action:none; z-index:1;"></canvas>

    <!-- WebGPU 不可用时的回退提示 -->
    <div
      id="td-nogpu"
      style="display:none; position:fixed; inset:0; place-items:center; background:#030408; z-index:100; text-align:center; color:#7d76a0; letter-spacing:0.06em; line-height:2.2; font-size:13px; font-family:Inter,PingFang SC,Microsoft YaHei,ui-sans-serif,system-ui,sans-serif;"
    >
      <div>
        <b style="color:#b09aff; font-size:15px;">{t('page.official.triggeredDischarge.webgpuUnavailable')}</b><br /><br
        />
        {t('page.official.triggeredDischarge.webgpuLine1')}<br />
        {t('page.official.triggeredDischarge.webgpuLine2')}
      </div>
    </div>

    <!-- 控制面板 -->
    <details
      id="td-panel"
      open
      style="position:fixed; top:16px; left:16px; width:min(278px, calc(100vw - 32px)); max-height:calc(100vh - 32px); overflow-y:auto; z-index:10; background:rgba(6,8,16,0.78); backdrop-filter:blur(20px) saturate(1.4); -webkit-backdrop-filter:blur(20px) saturate(1.4); border:1px solid rgba(140,120,240,0.18); border-radius:8px; user-select:none; box-shadow:0 4px 24px rgba(0,0,0,0.5),inset 0 1px 0 rgba(255,255,255,0.03); color:#e8e0ff; font:12px/1.5 Inter,PingFang SC,Microsoft YaHei,ui-sans-serif,system-ui,sans-serif; letter-spacing:0.02em; scrollbar-width:thin; scrollbar-color:rgba(176,154,255,0.25) transparent;"
    >
      <summary
        style="list-style:none; cursor:pointer; padding:12px 16px; display:flex; justify-content:space-between; align-items:baseline; gap:10px; border-radius:8px;"
      >
        <span style="letter-spacing:0.1em; font-weight:700; font-size:13px;"
          >{t('page.official.triggeredDischarge.panelTitle')}</span
        >
        <span style="letter-spacing:0.08em; color:#7d76a0; font-size:10px;">2D DBM · MTLE</span>
      </summary>

      <div style="padding:0 16px 16px;">
        <!-- 遥测网格 -->
        <div
          class="td-readout"
          style="display:grid; grid-template-columns:1fr 1fr; gap:1px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.05); border-radius:6px; overflow:hidden; margin-bottom:14px;"
        >
          <div class="td-cell" style="background:rgba(4,5,12,0.9); padding:8px 10px;">
            <b
              style="display:block; font-weight:500; font-size:9px; letter-spacing:0.08em; color:#7d76a0; margin-bottom:2px;"
              >{t('page.official.triggeredDischarge.phase')}</b
            ><span class="td-phase" id="td-rPhase" style="font-size:13px; font-weight:600; color:#b09aff;"
              >{t('page.official.triggeredDischarge.charging')}</span
            >
          </div>
          <div class="td-cell" style="background:rgba(4,5,12,0.9); padding:8px 10px;">
            <b
              style="display:block; font-weight:500; font-size:9px; letter-spacing:0.08em; color:#7d76a0; margin-bottom:2px;"
              >{t('page.official.triggeredDischarge.realTime')}</b
            ><span id="td-rTime" style="font-size:13px; font-weight:600;">0 µs</span>
          </div>
          <div class="td-cell" style="background:rgba(4,5,12,0.9); padding:8px 10px;">
            <b
              style="display:block; font-weight:500; font-size:9px; letter-spacing:0.08em; color:#7d76a0; margin-bottom:2px;"
              >{t('page.official.triggeredDischarge.slowMotion')}</b
            ><span id="td-rSlow" style="font-size:13px; font-weight:600;">—</span>
          </div>
          <div class="td-cell" style="background:rgba(4,5,12,0.9); padding:8px 10px;">
            <b
              style="display:block; font-weight:500; font-size:9px; letter-spacing:0.08em; color:#7d76a0; margin-bottom:2px;"
              >{t('page.official.triggeredDischarge.current')}</b
            ><span id="td-rAmp" style="font-size:13px; font-weight:600;">0 kA</span>
          </div>
          <div class="td-cell" style="background:rgba(4,5,12,0.9); padding:8px 10px;">
            <b
              style="display:block; font-weight:500; font-size:9px; letter-spacing:0.08em; color:#7d76a0; margin-bottom:2px;"
              >{t('page.official.triggeredDischarge.stroke')}</b
            ><span id="td-rStroke" style="font-size:13px; font-weight:600;">—</span>
          </div>
          <div class="td-cell" style="background:rgba(4,5,12,0.9); padding:8px 10px;">
            <b
              style="display:block; font-weight:500; font-size:9px; letter-spacing:0.08em; color:#7d76a0; margin-bottom:2px;"
              >{t('page.official.triggeredDischarge.channelLength')}</b
            ><span id="td-rLen" style="font-size:13px; font-weight:600;">—</span>
          </div>
          <div class="td-cell" style="background:rgba(4,5,12,0.9); padding:8px 10px;">
            <b
              style="display:block; font-weight:500; font-size:9px; letter-spacing:0.08em; color:#7d76a0; margin-bottom:2px;"
              >{t('page.official.triggeredDischarge.fractalDim')}</b
            ><span id="td-rDim" style="font-size:13px; font-weight:600;">—</span>
          </div>
          <div class="td-cell" style="background:rgba(4,5,12,0.9); padding:8px 10px;">
            <b
              style="display:block; font-weight:500; font-size:9px; letter-spacing:0.08em; color:#7d76a0; margin-bottom:2px;"
              >{t('page.official.triggeredDischarge.tipSpeed')}</b
            ><span id="td-rTip" style="font-size:13px; font-weight:600;">—</span>
          </div>
          <div class="td-cell" style="background:rgba(4,5,12,0.9); padding:8px 10px;">
            <b
              style="display:block; font-weight:500; font-size:9px; letter-spacing:0.08em; color:#7d76a0; margin-bottom:2px;"
              >{t('page.official.triggeredDischarge.fieldResidual')}</b
            ><span id="td-rRes" style="font-size:13px; font-weight:600;">—</span>
          </div>
          <div class="td-cell" style="background:rgba(4,5,12,0.9); padding:8px 10px;">
            <b
              style="display:block; font-weight:500; font-size:9px; letter-spacing:0.08em; color:#7d76a0; margin-bottom:2px;"
              >{t('page.official.triggeredDischarge.thunder')}</b
            ><span id="td-rThun" style="font-size:13px; font-weight:600;">—</span>
          </div>
        </div>

        <!-- 分支指数滑块 -->
        <div style="margin:12px 0 4px;">
          <label
            style="display:flex; justify-content:space-between; align-items:center; letter-spacing:0.06em; font-size:10px; font-weight:500; color:#7d76a0; margin-bottom:6px;"
          >
            <span>{t('page.official.triggeredDischarge.branchIndex')}</span>
            <output
              id="td-oEta"
              style="color:#b09aff; font-variant-numeric:tabular-nums; font-weight:600; font-size:11px;">2.00</output
            >
          </label>
          <input
            type="range"
            id="td-eta"
            min="1"
            max="4"
            step="0.05"
            value="2"
            style="width:100%; height:20px; appearance:none; background:transparent; cursor:ew-resize;"
          />
        </div>
        <p
          class="td-note"
          style="color:#7d76a0; font-size:10px; line-height:1.6; margin:10px 0 2px; padding:10px; background:rgba(255,255,255,0.015); border-radius:6px; border:1px solid rgba(255,255,255,0.03);"
        >
          {t('page.official.triggeredDischarge.branchNotePrefix')}<sup style="color:#b09aff; font-weight:600;">η</sup
          ><em style="color:#b09aff; font-style:normal; font-weight:600;">η ≈ 2</em>
          {t('page.official.triggeredDischarge.branchNoteSuffix')}
        </p>

        <!-- 峰值电流 -->
        <div style="margin:12px 0 4px;">
          <label
            style="display:flex; justify-content:space-between; align-items:center; letter-spacing:0.06em; font-size:10px; font-weight:500; color:#7d76a0; margin-bottom:6px;"
          >
            <span>{t('page.official.triggeredDischarge.peakCurrent')}</span>
            <output
              id="td-oCur"
              style="color:#b09aff; font-variant-numeric:tabular-nums; font-weight:600; font-size:11px;">30</output
            >
          </label>
          <input
            type="range"
            id="td-cur"
            min="10"
            max="120"
            step="1"
            value="30"
            style="width:100%; height:20px; appearance:none; background:transparent; cursor:ew-resize;"
          />
        </div>

        <!-- 时间倍率 -->
        <div style="margin:12px 0 4px;">
          <label
            style="display:flex; justify-content:space-between; align-items:center; letter-spacing:0.06em; font-size:10px; font-weight:500; color:#7d76a0; margin-bottom:6px;"
          >
            <span>{t('page.official.triggeredDischarge.timeScale')}</span>
            <output
              id="td-oDil"
              style="color:#b09aff; font-variant-numeric:tabular-nums; font-weight:600; font-size:11px;">1.0</output
            >
          </label>
          <input
            type="range"
            id="td-dil"
            min="0.25"
            max="4"
            step="0.05"
            value="1"
            style="width:100%; height:20px; appearance:none; background:transparent; cursor:ew-resize;"
          />
        </div>

        <!-- 曝光 -->
        <div style="margin:12px 0 4px;">
          <label
            style="display:flex; justify-content:space-between; align-items:center; letter-spacing:0.06em; font-size:10px; font-weight:500; color:#7d76a0; margin-bottom:6px;"
          >
            <span>{t('page.official.triggeredDischarge.exposure')}</span>
            <output
              id="td-oExp"
              style="color:#b09aff; font-variant-numeric:tabular-nums; font-weight:600; font-size:11px;">1.20</output
            >
          </label>
          <input
            type="range"
            id="td-exp"
            min="0.4"
            max="2.6"
            step="0.05"
            value="1.2"
            style="width:100%; height:20px; appearance:none; background:transparent; cursor:ew-resize;"
          />
        </div>

        <!-- 泛光 -->
        <div style="margin:12px 0 4px;">
          <label
            style="display:flex; justify-content:space-between; align-items:center; letter-spacing:0.06em; font-size:10px; font-weight:500; color:#7d76a0; margin-bottom:6px;"
          >
            <span>{t('page.official.triggeredDischarge.bloom')}</span>
            <output
              id="td-oBlm"
              style="color:#b09aff; font-variant-numeric:tabular-nums; font-weight:600; font-size:11px;">0.70</output
            >
          </label>
          <input
            type="range"
            id="td-blm"
            min="0"
            max="1.6"
            step="0.05"
            value="0.7"
            style="width:100%; height:20px; appearance:none; background:transparent; cursor:ew-resize;"
          />
        </div>

        <!-- 按钮 -->
        <div class="td-btns" style="display:grid; grid-template-columns:1fr 1fr; gap:6px; margin-top:14px;">
          <button
            id="td-bNew"
            style="grid-column:1/-1; font:inherit; font-size:11px; font-weight:600; letter-spacing:0.1em; color:#fff; background:rgba(176,154,255,0.14); border:1px solid rgba(176,154,255,0.3); border-radius:6px; padding:11px; cursor:pointer;"
            >{t('page.official.triggeredDischarge.newLightning')}</button
          >
          <button
            id="td-bPause"
            aria-pressed="false"
            style="font:inherit; font-size:10px; font-weight:600; letter-spacing:0.06em; color:#e8e0ff; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08); border-radius:6px; padding:9px 6px; cursor:pointer;"
            >{t('page.official.triggeredDischarge.pause')}</button
          >
          <button
            id="td-bSnd"
            aria-pressed="false"
            style="font:inherit; font-size:10px; font-weight:600; letter-spacing:0.06em; color:#e8e0ff; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08); border-radius:6px; padding:9px 6px; cursor:pointer;"
            >{t('page.official.triggeredDischarge.soundOff')}</button
          >
          <button
            id="td-bPng"
            style="font:inherit; font-size:10px; font-weight:600; letter-spacing:0.06em; color:#e8e0ff; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08); border-radius:6px; padding:9px 6px; cursor:pointer;"
            >{t('page.official.triggeredDischarge.saveScreenshot')}</button
          >
          <button
            id="td-bPol"
            aria-pressed="false"
            style="font:inherit; font-size:10px; font-weight:600; letter-spacing:0.06em; color:#e8e0ff; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08); border-radius:6px; padding:9px 6px; cursor:pointer;"
            >{t('page.official.triggeredDischarge.polarityNeg')}</button
          >
          <button
            id="td-bStorm"
            aria-pressed="false"
            style="font:inherit; font-size:10px; font-weight:600; letter-spacing:0.06em; color:#e8e0ff; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08); border-radius:6px; padding:9px 6px; cursor:pointer;"
            >{t('page.official.triggeredDischarge.normalMode')}</button
          >
        </div>
      </div>
    </details>

    <!-- 覆盖层 -->
    <div
      id="td-hint"
      style="position:fixed; bottom:24px; left:50%; transform:translateX(-50%); z-index:5; color:rgba(125,118,160,0.45); letter-spacing:0.12em; font-size:11px; font-weight:500; pointer-events:none; font-family:Inter,PingFang SC,Microsoft YaHei,ui-sans-serif,system-ui,sans-serif;"
    >
      {t('page.official.triggeredDischarge.clickHint')}
    </div>
    <div
      id="td-sig"
      style="position:fixed; bottom:20px; right:20px; z-index:5; color:rgba(125,118,160,0.35); letter-spacing:0.12em; font-size:10px; font-weight:500; font-family:Inter,PingFang SC,Microsoft YaHei,ui-sans-serif,system-ui,sans-serif;"
    >
      {t('page.official.triggeredDischarge.signature')}
    </div>

    <!-- 返回按钮 -->
    <div style="position:fixed; top:16px; right:16px; z-index:20;">
      <a
        href={buildUrl('/apps')}
        style="display:inline-block; background:rgba(6,8,16,0.78); backdrop-filter:blur(20px); border:1px solid rgba(140,120,240,0.18); border-radius:6px; padding:8px 14px; color:#e8e0ff; font:12px/1.5 Inter,PingFang SC,Microsoft YaHei,ui-sans-serif,system-ui,sans-serif; letter-spacing:0.06em; text-decoration:none;"
      >
        {t('page.official.triggeredDischarge.back')}
      </a>
    </div>
  </div>
</Layout>

<!-- Vite 会处理内联模块导入，自动打包为正确的客户端资源路径 -->
<script>
  import('../../features/triggered-discharge/entry.js');
</script>
