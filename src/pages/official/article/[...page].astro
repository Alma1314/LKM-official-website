---
import { Pagination } from '~/ui/primitives';
import PostPage from '~/features/team/components/PostPage.astro';
import { PAGE_SIZE } from '~/core/constants/constants';
import MainGridLayout from '~/layouts/OfficialBlogMainGridLayout.astro';
import { getSortedPosts } from '~/core/utils/content-utils';
import { url } from '~/core/utils/url-utils';

export async function getStaticPaths() {
  const allBlogPosts = await getSortedPosts();
  const totalPages = Math.ceil(allBlogPosts.length / PAGE_SIZE);
  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: i === 0 ? undefined : String(i + 1) },
    props: {
      page: {
        data: allBlogPosts.slice(i * PAGE_SIZE, (i + 1) * PAGE_SIZE),
        currentPage: i + 1,
        totalPages,
        prev: i > 0 ? (i === 1 ? url('/official/article') : url(`/official/article/page/${i}`)) : undefined,
        next: i < totalPages - 1 ? url(`/official/article/page/${i + 2}`) : undefined,
      },
    },
  }));
}

const { page } = Astro.props;
const len = page.data.length;
---

<MainGridLayout>
  <PostPage page={page} />
  <Pagination
    class="mx-auto onload-animation"
    page={page}
    style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
  />
</MainGridLayout>
