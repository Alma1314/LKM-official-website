---
import Layout from '~/layouts/OfficialSidebarLayout.astro';
import { communitySidebarLinks } from '~/features/shell-official/data/community-sidebar';
import ProjectHall from '~/features/project-hub/components/ProjectHall.vue';
import { getPermalink } from '~/lib/utils/permalinks';

const metadata = { title: '项目大厅 —— 理科迷' };
---

<Layout metadata={metadata} sidebarLinks={communitySidebarLinks} currentPath={getPermalink('/projects')}>
  <div class="space-y-6">
    <h1 class="text-3xl font-bold text-deep-text">项目大厅</h1>
    <div style="min-height: 400px"><ProjectHall client:only="vue" /></div>
  </div>
</Layout>
