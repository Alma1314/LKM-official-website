---
import type { ImageMetadata } from '~/types/core';
import Layout from '~/layouts/OfficialSidebarLayout.astro';
import MemberCard from '~/features/team/components/MemberCard.astro';
import DepartmentSection from '~/features/team/components/DepartmentSection.astro';

import { teamApi } from '~/lib/api';
import type { TeamSubGroup } from '~/lib/api/modules/team';

import { getPermalink } from '~/lib/utils/permalinks';

// 从后端拉取项目团队各分组成员数据（subGroupMaps 类型）
const res = await teamApi.getSubGroups('projectSubGroups');
const groups: TeamSubGroup[] = res.isOk() ? (res.value?.items ?? []) : [];

// 自动导入所有优化后的成员头像（WebP, 192px）
const avatarModules = import.meta.glob('~/assets/images/member-optimized/*.webp', {
  eager: true,
});

// 缓存映射表，避免重复查找
const avatarCache = new Map<string, ImageMetadata>();

function getAvatar(filename?: string): ImageMetadata | undefined {
  if (!filename) return undefined;

  if (avatarCache.has(filename)) {
    return avatarCache.get(filename);
  }

  const webpName = filename.replace(/\.(jpe?g|png)$/i, '.webp');
  const fullPath = `/src/assets/images/member-optimized/${webpName}`;
  const module = avatarModules[fullPath];

  if (module && typeof module === 'object' && 'default' in module) {
    const image = module.default as ImageMetadata;
    avatarCache.set(filename, image);
    return image;
  }

  return undefined;
}

const metadata = {
  title: '项目团队 —— 理科迷',
};

const sidebarLinks = [
  { text: '教材项目组', href: getPermalink('/official/project-team#textbooks'), icon: 'tabler:books' },
  { text: '科普项目组', href: getPermalink('/official/project-team#science'), icon: 'tabler:flask' },
];
---

<Layout
  metadata={metadata}
  sidebarLinks={sidebarLinks}
  currentPath={getPermalink('/official/project-team')}
  navItems={['主页', '新闻资讯', '寻求帮助', '七月团队', '资源']}
>
  <!-- 项目小组 -->
  {
    groups.map((group) => (
      <DepartmentSection
        id={group.key}
        title={group.label}
        borderColor={group.key === 'textbooks' ? '#14b8a6' : '#a855f7'}
        desc={group.desc ?? ''}
      >
        {group.members.length > 0 ? (
          <>
            {group.members.map((m) => (
              <MemberCard
                name={m.name ?? '匿名成员'}
                avatar={getAvatar(m.avatarKey)}
                desc={m.desc}
                dream={m.dream}
                quote={m.quote}
              />
            ))}
          </>
        ) : (
          <p class="col-span-full text-center text-sm text-text-muted/50 py-6">暂无成员，期待你的加入</p>
        )}
      </DepartmentSection>
    ))
  }
</Layout>
