---
import Layout from '~/layouts/OfficialSidebarLayout.astro';
import MemberCard from '~/features/team/components/MemberCard.astro';
import DepartmentSection from '~/features/team/components/DepartmentSection.astro';

import { teamApi } from '~/lib/api';
import type { TeamSubGroup } from '~/lib/api/modules/team';

import { avatarUrl } from '~/lib/utils/avatars';
import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

// 从后端拉取项目团队各分组成员数据（subGroupMaps 类型）
const res = await teamApi.getSubGroups('projectSubGroups');
const groups: TeamSubGroup[] = res.isOk() ? (res.value?.items ?? []) : [];

// 头像由后端 /api/v1/avatars/*.webp 提供，avatarUrl 负责把 avatarKey 映射为 API URL

const metadata = {
  title: t('page.official.projectTeam.metaTitle'),
};

const sidebarLinks = [
  {
    text: t('page.official.projectTeam.sidebarTextbooks'),
    href: getPermalink('/official/project-team#textbooks'),
    icon: 'tabler:books',
  },
  {
    text: t('page.official.projectTeam.sidebarScience'),
    href: getPermalink('/official/project-team#science'),
    icon: 'tabler:flask',
  },
];
---

<Layout
  metadata={metadata}
  sidebarLinks={sidebarLinks}
  currentPath={getPermalink('/official/project-team')}
  navItems={['nav.home', 'nav.news', 'nav.team', 'nav.resources']}
>
  <!-- 项目小组 -->
  {
    groups.map((group) => (
      <DepartmentSection
        id={group.key}
        title={t(group.label)}
        borderColor={group.key === 'textbooks' ? '#14b8a6' : '#a855f7'}
        desc={t(group.desc ?? '')}
      >
        {group.members.length > 0 ? (
          <>
            {group.members.map((m) => (
              <MemberCard
                name={m.name ?? t('page.official.anonymous')}
                avatar={avatarUrl(m.avatarKey)}
                desc={m.desc}
                dream={m.dream}
                quote={m.quote}
              />
            ))}
          </>
        ) : (
          <p class="col-span-full text-center text-sm text-text-muted/50 py-6">
            {t('page.official.projectTeam.empty')}
          </p>
        )}
      </DepartmentSection>
    ))
  }
</Layout>
