---
import Layout from '~/layouts/OfficialSidebarLayout.astro';
import CommunityCard from '~/features/team/components/CommunityCard.astro';
import CommunitySection from '~/features/team/components/CommunitySection.astro';

import { communityCategories, communityNote } from '~/features/team/data/communities';
import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

const metadata = {
  title: t('page.official.communities.metaTitle'),
};

const sidebarLinks = [
  {
    text: t('page.official.communities.sidebarGeneral'),
    href: getPermalink('/official/communities#general'),
    icon: 'tabler:users',
  },
  {
    text: t('page.official.communities.sidebarGrades'),
    href: getPermalink('/official/communities#grades'),
    icon: 'tabler:school',
  },
  {
    text: t('page.official.communities.sidebarGroups'),
    href: getPermalink('/official/communities#groups'),
    icon: 'tabler:category',
  },
  {
    text: t('page.official.communities.sidebarBasic'),
    href: getPermalink('/official/communities#basic'),
    icon: 'tabler:atom',
  },
  {
    text: t('page.official.communities.sidebarApplied'),
    href: getPermalink('/official/communities#applied'),
    icon: 'tabler:robot',
  },
  {
    text: t('page.official.communities.sidebarHobby'),
    href: getPermalink('/official/communities#hobby'),
    icon: 'tabler:palette',
  },
  {
    text: t('page.official.communities.sidebarEvents'),
    href: getPermalink('/official/communities#events'),
    icon: 'tabler:calendar-star',
  },
  {
    text: t('page.official.communities.sidebarLegacy'),
    href: getPermalink('/official/communities#legacy'),
    icon: 'tabler:archive',
  },
];

const sectionIds = ['general', 'grades', 'groups', 'basic', 'applied', 'hobby', 'events', 'legacy'];
---

<Layout
  metadata={metadata}
  sidebarLinks={sidebarLinks}
  currentPath={getPermalink('/official/communities')}
  navItems={['nav.home', 'nav.news', 'nav.team', 'nav.resources']}
>
  {
    communityCategories.map((cat, i) => (
      <CommunitySection id={sectionIds[i]} title={cat.label} intro={cat.intro}>
        {cat.groups.map((g) => (
          <CommunityCard name={g.name} qqGroup={g.qqGroup} desc={g.desc} isQQChannel={g.isQQChannel} />
        ))}
      </CommunitySection>
    ))
  }

  <!-- 底部注记 -->
  <div class="max-w-7xl mx-auto mt-4">
    <p class="text-center text-sm text-text-muted/60 italic">{t(communityNote)}</p>
  </div>
</Layout>
