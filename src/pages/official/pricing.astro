---
import Layout from '~/layouts/OfficialSidebarLayout.astro';
import HeroText from '~/features/homepage/components/HeroText.astro';
import Features3 from '~/features/homepage/components/Features3.astro';
import CallToAction from '~/features/homepage/components/CallToAction.astro';

import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

const metadata = {
  title: t('page.official.pricing.metaTitle'),
};
---

<Layout
  metadata={metadata}
  currentPath={getPermalink('/official/pricing')}
  navItems={['nav.home', 'nav.news', 'nav.team', 'nav.resources']}
>
  <!-- 首屏 -->
  <HeroText title={t('page.official.pricing.heroTitle')} subtitle={t('page.official.pricing.heroSubtitle')} />

  <!-- 支持方式 -->
  <Features3
    id="support"
    title={t('page.official.pricing.supportTitle')}
    subtitle={t('page.official.pricing.supportSubtitle')}
    columns={2}
    items={[
      {
        title: t('page.official.pricing.joinCommunity'),
        description: t('page.official.pricing.joinCommunityDesc'),
        icon: 'tabler:users-plus',
      },
      {
        title: t('page.official.pricing.createContent'),
        description: t('page.official.pricing.createContentDesc'),
        icon: 'tabler:pencil',
      },
      {
        title: t('page.official.pricing.participateMgmt'),
        description: t('page.official.pricing.participateMgmtDesc'),
        icon: 'tabler:building-community',
      },
      {
        title: t('page.official.pricing.participateProject'),
        description: t('page.official.pricing.participateProjectDesc'),
        icon: 'tabler:clipboard-list',
      },
      {
        title: t('page.official.pricing.cooperation'),
        description: t('page.official.pricing.cooperationDesc'),
        icon: 'tabler:affiliate',
      },
      {
        title: t('page.official.pricing.promotion'),
        description: t('page.official.pricing.promotionDesc'),
        icon: 'tabler:share',
      },
      {
        title: t('page.official.pricing.techSupport'),
        description: t('page.official.pricing.techSupportDesc'),
        icon: 'tabler:code',
      },
      {
        title: t('page.official.pricing.suggestions'),
        description: t('page.official.pricing.suggestionsDesc'),
        icon: 'tabler:bulb',
      },
    ]}
    classes={{ container: 'max-w-4xl mx-auto' }}
  />

  <!-- 常见问题 -->
  <Features3
    id="faq"
    title={t('page.official.pricing.faqTitle')}
    subtitle={t('page.official.pricing.faqSubtitle')}
    columns={2}
    items={[
      {
        title: t('page.official.pricing.payQuestion'),
        description: t('page.official.pricing.payAnswer'),
        icon: 'tabler:free-rights',
      },
      {
        title: t('page.official.pricing.fundingSource'),
        description: t('page.official.pricing.fundingSourceAnswer'),
        icon: 'tabler:coin',
      },
      {
        title: t('page.official.pricing.transparency'),
        description: t('page.official.pricing.transparencyAnswer'),
        icon: 'tabler:chart-bar',
      },
      {
        title: t('page.official.pricing.multiDept'),
        description: t('page.official.pricing.multiDeptAnswer'),
        icon: 'tabler:layout-grid',
      },
      {
        title: t('page.official.pricing.proposeProject'),
        description: t('page.official.pricing.proposeProjectAnswer'),
        icon: 'tabler:rocket',
      },
      {
        title: t('page.official.pricing.noExperience'),
        description: t('page.official.pricing.noExperienceAnswer'),
        icon: 'tabler:user-heart',
      },
      {
        title: t('page.official.pricing.system'),
        description: t('page.official.pricing.systemAnswer'),
        icon: 'tabler:building',
      },
      {
        title: t('page.official.pricing.contributionRecord'),
        description: t('page.official.pricing.contributionRecordAnswer'),
        icon: 'tabler:history',
      },
    ]}
    classes={{ container: 'max-w-4xl mx-auto' }}
  />

  <!-- 行动号召 -->
  <CallToAction
    title={t('page.official.pricing.ctaTitle')}
    subtitle={t('page.official.pricing.ctaSubtitle')}
    actions={[
      {
        variant: 'primary',
        text: t('page.official.pricing.contactUs'),
        href: getPermalink('/official/contact'),
      },
    ]}
  />
</Layout>
