---
import Layout from '~/layouts/OfficialSidebarLayout.astro';
import Section from '~/features/homepage/components/Section.astro';
import MemberCard from '~/features/team/components/MemberCard.astro';
import DepartmentSection from '~/features/team/components/DepartmentSection.astro';

import { teamApi } from '~/lib/api';
import type { TeamMember, TeamSubGroup } from '~/lib/api/modules/team';

import { avatarUrl } from '~/lib/utils/avatars';
import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

// ---- 从后端拉取成员数据 ----
// 统一解包 Result：ok 返回 data，err 返回空数组（页面降级为空，不中断渲染）

async function fetchMembers(type: string): Promise<TeamMember[]> {
  const res = await teamApi.getMembers(type);
  if (res.isOk()) return res.value?.items ?? [];
  return [];
}

async function fetchSubGroups(type: string): Promise<TeamSubGroup[]> {
  const res = await teamApi.getSubGroups(type);
  if (res.isOk()) return res.value?.items ?? [];
  return [];
}

// memberLists 各分组
const [founderMembers, generalMembers, eventsMembers, newsMembers, advisorMembers, techMembers, alumniMembers] =
  await Promise.all([
    fetchMembers('founderMembers'),
    fetchMembers('generalMembers'),
    fetchMembers('eventsMembers'),
    fetchMembers('newsMembers'),
    fetchMembers('advisorMembers'),
    fetchMembers('techMembers'),
    fetchMembers('alumniMembers'),
  ]);

// subGroupMaps 各分组（后端返回数组，转为 key→group 的 Record 以适配模板遍历）
function toGroups(items: TeamSubGroup[]): Record<string, TeamSubGroup> {
  const map: Record<string, TeamSubGroup> = {};
  for (const g of items) map[g.key] = g;
  return map;
}

const [affairsSubGroups, newsSubGroups, professionalSubGroups] = await Promise.all([
  fetchSubGroups('affairsSubGroups'),
  fetchSubGroups('newsSubGroups'),
  fetchSubGroups('professionalSubGroups'),
]);
const affairsSubGroupsMap = toGroups(affairsSubGroups);
const newsSubGroupsMap = toGroups(newsSubGroups);
const professionalSubGroupsMap = toGroups(professionalSubGroups);

// 头像由后端 /api/v1/avatars/*.webp 提供，avatarUrl 负责把 avatarKey 映射为 API URL

const metadata = {
  title: t('page.official.team.metaTitle'),
};

const sidebarLinks = [
  { text: t('page.official.team.sidebarFounder'), href: getPermalink('/official/team#founder'), icon: 'tabler:star' },
  {
    text: t('page.official.team.sidebarGeneral'),
    href: getPermalink('/official/team#general'),
    icon: 'tabler:building-skyscraper',
  },
  {
    text: t('page.official.team.sidebarAffairs'),
    href: getPermalink('/official/team#affairs'),
    icon: 'tabler:users-group',
  },
  {
    text: t('page.official.team.sidebarEvents'),
    href: getPermalink('/official/team#events'),
    icon: 'tabler:calendar-event',
  },
  { text: t('page.official.team.sidebarNews'), href: getPermalink('/official/team#news'), icon: 'tabler:news' },
  {
    text: t('page.official.team.sidebarAdvisors'),
    href: getPermalink('/official/team#advisors'),
    icon: 'tabler:user-check',
  },
  {
    text: t('page.official.team.sidebarProfessional'),
    href: getPermalink('/official/team#professional'),
    icon: 'tabler:certificate',
  },
  { text: t('page.official.team.sidebarTech'), href: getPermalink('/official/team#tech'), icon: 'tabler:code' },
  { text: t('page.official.team.sidebarAlumni'), href: getPermalink('/official/team#alumni'), icon: 'tabler:user-x' },
];
---

<Layout
  metadata={metadata}
  sidebarLinks={sidebarLinks}
  currentPath={getPermalink('/official/team')}
  navItems={['nav.home', 'nav.news', 'nav.team', 'nav.resources']}
>
  <!-- 创始人 -->
  <Section title={t('page.official.team.founderTitle')} subtitle={t('page.official.team.founderSubtitle')} id="founder">
    <div class="max-w-2xl mx-auto">
      {
        founderMembers.map((m) => (
          <MemberCard
            name={m.name ?? t('page.official.anonymous')}
            avatar={avatarUrl(m.avatarKey)}
            role={m.role}
            size="lg"
            desc={m.desc}
            dream={m.dream}
            quote={m.quote}
          />
        ))
      }
    </div>
  </Section>

  <!-- 总务部 -->
  <DepartmentSection
    id="general"
    title={t('page.official.team.generalTitle')}
    borderColor="#ef4444"
    desc={t('page.official.team.generalDesc')}
  >
    {
      generalMembers.map((m) => (
        <MemberCard
          name={m.name ?? t('page.official.anonymous')}
          avatar={avatarUrl(m.avatarKey)}
          desc={m.desc}
          dream={m.dream}
          quote={m.quote}
        />
      ))
    }
  </DepartmentSection>

  <!-- 群务部 -->
  <DepartmentSection
    id="affairs"
    title={t('page.official.team.affairsTitle')}
    borderColor="#3b82f6"
    desc={t('page.official.team.affairsDesc')}
    noGrid
  >
    {
      Object.entries(affairsSubGroupsMap).map(([, group]) => (
        <div class="mb-12">
          <h4 class="text-md font-bold mb-3 text-center text-text-muted">{t(group.label)}</h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {group.members.map((m) => (
              <MemberCard
                name={m.name ?? t('page.official.anonymous')}
                avatar={avatarUrl(m.avatarKey)}
                desc={m.desc}
                dream={m.dream}
                quote={m.quote}
              />
            ))}
          </div>
        </div>
      ))
    }
  </DepartmentSection>

  <!-- 活动策划部 -->
  <DepartmentSection
    id="events"
    title={t('page.official.team.eventsTitle')}
    borderColor="#f97316"
    desc={t('page.official.team.eventsDesc')}
  >
    {
      eventsMembers.map((m) => (
        <MemberCard
          name={m.name ?? t('page.official.anonymous')}
          avatar={avatarUrl(m.avatarKey)}
          role={m.role}
          desc={m.desc}
          dream={m.dream}
          quote={m.quote}
        />
      ))
    }
  </DepartmentSection>

  <!-- 新闻办 -->
  <DepartmentSection
    id="news"
    title={t('page.official.team.newsTitle')}
    borderColor="#22c55e"
    desc={t('page.official.team.newsDesc')}
    noGrid
  >
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        newsMembers.map((m) => (
          <MemberCard
            name={m.name ?? t('page.official.anonymous')}
            avatar={avatarUrl(m.avatarKey)}
            desc={m.desc}
            dream={m.dream}
            quote={m.quote}
          />
        ))
      }
    </div>
    {
      Object.entries(newsSubGroupsMap).map(([, group]) => (
        <div class="mt-8">
          <h4 class="text-md font-bold mb-3 text-center text-text-muted">{t(group.label)}</h4>
          <p class="max-w-3xl mx-auto mb-6 px-6 py-3 bg-page-bg border border-surface-3 rounded-[8px] text-center text-[13px] text-text-muted leading-relaxed">
            {t(group.desc)}
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {group.members.map((m) => (
              <MemberCard
                name={m.name ?? t('page.official.anonymous')}
                avatar={avatarUrl(m.avatarKey)}
                desc={m.desc}
                dream={m.dream}
                quote={m.quote}
              />
            ))}
          </div>
        </div>
      ))
    }
  </DepartmentSection>

  <!-- 顾问团 -->
  <DepartmentSection
    id="advisors"
    title={t('page.official.team.advisorsTitle')}
    borderColor="#eab308"
    desc={t('page.official.team.advisorsDesc')}
  >
    {
      advisorMembers.map((m) => (
        <MemberCard
          name={m.name ?? t('page.official.anonymous')}
          avatar={avatarUrl(m.avatarKey)}
          role={m.role}
          desc={m.desc}
          dream={m.dream}
          quote={m.quote}
        />
      ))
    }
  </DepartmentSection>

  <!-- 专业委员会 -->
  <DepartmentSection
    id="professional"
    title={t('page.official.team.professionalTitle')}
    borderColor="#a855f7"
    desc={t('page.official.team.professionalDesc')}
    noGrid
  >
    {
      Object.entries(professionalSubGroupsMap).map(([, group]) => (
        <div class="mb-12">
          <h4 class="text-md font-bold mb-3 text-center text-text-muted">{t(group.label)}</h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {group.members.map((m) => (
              <MemberCard
                name={m.name ?? t('page.official.anonymous')}
                avatar={avatarUrl(m.avatarKey)}
                desc={m.desc}
                dream={m.dream}
                quote={m.quote}
              />
            ))}
          </div>
        </div>
      ))
    }
  </DepartmentSection>

  <!-- 技术委员会 -->
  <DepartmentSection
    id="tech"
    title={t('page.official.team.techTitle')}
    borderColor="#6b7280"
    desc={t('page.official.team.techDesc')}
  >
    {
      techMembers.map((m) => (
        <MemberCard
          name={m.name ?? t('page.official.anonymous')}
          avatar={avatarUrl(m.avatarKey)}
          role={m.role}
          desc={m.desc}
          dream={m.dream}
          quote={m.quote}
        />
      ))
    }
  </DepartmentSection>

  <!-- 已离开成员 -->
  <Section id="alumni">
    <div class="max-w-7xl mx-auto">
      <h3 class="text-xl font-bold mb-9 text-center">
        <span class="border-b-2 border-surface-3 pb-1">{t('page.official.team.alumniHeading')}</span>
      </h3>
      <p
        class="max-w-3xl mx-auto mb-9 px-6 py-4 bg-page-bg border border-surface-3 rounded-[8px] text-center text-[14px] text-text-muted leading-relaxed"
      >
        {t('page.official.team.alumniNote')}
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          alumniMembers.map((m) => (
            <MemberCard
              name={m.name ?? t('page.official.anonymous')}
              avatar={avatarUrl(m.avatarKey)}
              role={m.role}
              desc={m.desc}
              dream={m.dream}
              quote={m.quote}
            />
          ))
        }
      </div>
    </div>
  </Section>
</Layout>
