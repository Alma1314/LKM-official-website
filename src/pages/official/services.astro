---
import CallToAction from '~/features/homepage/components/CallToAction.astro';
import Features2 from '~/features/homepage/components/Features2.astro';
import HeroText from '~/features/homepage/components/HeroText.astro';
import Layout from '~/layouts/OfficialSidebarLayout.astro';

import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

const metadata = {
  title: t('page.official.services.metaTitle'),
};

const sidebarLinks = [
  {
    text: t('page.official.services.sidebarContent'),
    href: getPermalink('/official/services#content'),
    icon: 'tabler:pencil',
  },
  {
    text: t('page.official.services.sidebarEvents'),
    href: getPermalink('/official/services#events'),
    icon: 'tabler:confetti',
  },
  {
    text: t('page.official.services.sidebarPlatform'),
    href: getPermalink('/official/services#platform'),
    icon: 'tabler:database',
  },
];
---

<Layout
  metadata={metadata}
  sidebarLinks={sidebarLinks}
  currentPath={getPermalink('/official/services')}
  navItems={['主页', '新闻资讯', '寻求帮助', '七月团队', '资源']}
>
  <!-- 首屏 -->
  <HeroText
    title={t('page.official.services.heroTitle')}
    subtitle={t('page.official.services.heroSubtitle')}
    callToAction={{
      text: t('page.official.services.joinUs'),
      href: getPermalink('/official/contact'),
      variant: 'primary',
    }}
  />

  <!-- 内容创作 -->
  <Features2
    id="content"
    title={t('page.official.services.contentTitle')}
    subtitle={t('page.official.services.contentSubtitle')}
    columns={3}
    items={[
      {
        title: t('page.official.services.newsTitle'),
        description: t('page.official.services.newsDesc'),
        icon: 'tabler:news',
      },
      {
        title: t('page.official.services.scienceTitle'),
        description: t('page.official.services.scienceDesc'),
        icon: 'tabler:atom',
      },
      {
        title: t('page.official.services.videoTitle'),
        description: t('page.official.services.videoDesc'),
        icon: 'tabler:video',
      },
      {
        title: t('page.official.services.helpTitle'),
        description: t('page.official.services.helpDesc'),
        icon: 'tabler:help-circle',
      },
      {
        title: t('page.official.services.deepDiveTitle'),
        description: t('page.official.services.deepDiveDesc'),
        icon: 'tabler:file-text',
      },
      {
        title: t('page.official.services.quizTitle'),
        description: t('page.official.services.quizDesc'),
        icon: 'tabler:trophy',
      },
      {
        title: t('page.official.services.resourcesTitle'),
        description: t('page.official.services.resourcesDesc'),
        icon: 'tabler:books',
      },
      {
        title: t('page.official.services.journalTitle'),
        description: t('page.official.services.journalDesc'),
        icon: 'tabler:book',
      },
      {
        title: t('page.official.services.exchangeTitle'),
        description: t('page.official.services.exchangeDesc'),
        icon: 'tabler:language',
      },
    ]}
  />

  <!-- 社区活动 -->
  <Features2
    id="events"
    title={t('page.official.services.eventsTitle')}
    subtitle={t('page.official.services.eventsSubtitle')}
    columns={2}
    items={[
      {
        title: t('page.official.services.holidayTitle'),
        description: t('page.official.services.holidayDesc'),
        icon: 'tabler:sun',
      },
      {
        title: t('page.official.services.seminarTitle'),
        description: t('page.official.services.seminarDesc'),
        icon: 'tabler:presentation',
      },
      {
        title: t('page.official.services.chatTitle'),
        description: t('page.official.services.chatDesc'),
        icon: 'tabler:messages',
      },
      {
        title: t('page.official.services.promoTitle'),
        description: t('page.official.services.promoDesc'),
        icon: 'tabler:brand-youtube',
      },
    ]}
  />

  <!-- 知识平台 -->
  <Features2
    id="platform"
    title={t('page.official.services.platformTitle')}
    subtitle={t('page.official.services.platformSubtitle')}
    columns={3}
    items={[
      {
        title: t('page.official.services.websiteTitle'),
        description: t('page.official.services.websiteDesc'),
        icon: 'tabler:world-www',
      },
      {
        title: t('page.official.services.blogTitle'),
        description: t('page.official.services.blogDesc'),
        icon: 'tabler:article',
      },
    ]}
  />

  <!-- 行动号召 -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: t('page.official.pricing.contactUs'),
        href: getPermalink('/official/contact'),
      },
    ]}
    subtitle={t('page.official.services.ctaSubtitle')}
  >
    <Fragment slot="title">
      {t('page.official.services.ctaTitlePrefix')}<span class="text-[#6C2AD8] dark:text-primary"
        >{t('page.official.services.brandName')}</span
      >{t('page.official.services.ctaTitleSuffix')}
    </Fragment>
  </CallToAction>
</Layout>
