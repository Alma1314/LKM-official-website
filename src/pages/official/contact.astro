---
import Layout from '~/layouts/OfficialSidebarLayout.astro';
import HeroText from '~/features/homepage/components/HeroText.astro';
import ContactUs from '~/features/homepage/components/Contact.astro';
import Features2 from '~/features/homepage/components/Features2.astro';

import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

const metadata = {
  title: t('page.official.contact.metaTitle'),
};
---

<Layout
  metadata={metadata}
  currentPath={getPermalink('/official/contact')}
  navItems={['nav.home', 'nav.news', 'nav.help', 'nav.team', 'nav.resources']}
>
  <!-- 首屏 -->
  <HeroText title={t('page.official.contact.heroTitle')} />

  <!-- 留言表单 -->
  <ContactUs
    id="form"
    title={t('page.official.contact.formTitle')}
    subtitle={t('page.official.contact.formSubtitle')}
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: t('page.official.contact.nameLabel'),
      },
      {
        type: 'email',
        name: 'email',
        label: t('page.official.contact.emailLabel'),
      },
    ]}
    textarea={{
      label: t('page.official.contact.messageLabel'),
    }}
    disclaimer={{
      label: t('page.official.contact.disclaimerLabel'),
    }}
    description={t('page.official.contact.replyNote')}
  />

  <!-- 联系方式 -->
  <Features2
    id="support"
    title={t('page.official.contact.supportTitle')}
    items={[
      {
        title: t('page.official.contact.joinCommunity'),
        description: t('page.official.contact.joinCommunityDesc'),
        icon: 'tabler:users-group',
        callToAction: {
          text: t('page.official.contact.viewAllCommunities'),
          href: getPermalink('/official/communities'),
        },
      },
      {
        title: t('page.official.contact.cooperation'),
        description: t('page.official.contact.cooperationDesc'),
        icon: 'tabler:heart-handshake',
      },
      {
        title: t('page.official.contact.feedback'),
        description: t('page.official.contact.feedbackDesc'),
        icon: 'tabler:bug',
      },
      {
        title: t('page.official.contact.email'),
        description: 'almafox123@outlook.com',
        icon: 'tabler:mail',
      },
      {
        title: t('page.official.contact.github'),
        description: 'github.com/LKM-AHZ',
        icon: 'tabler:brand-github',
      },
      {
        title: t('page.official.contact.bilibili'),
        description: t('page.official.contact.bilibiliDesc'),
        icon: 'tabler:brand-bilibili',
      },
    ]}
  />
</Layout>
