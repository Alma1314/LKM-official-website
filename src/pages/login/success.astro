---
import PageLayout from '~/layouts/PageLayout.astro';
import OAuthCallback from '~/features/auth/components/login/OAuthCallback.vue';
import { t } from '~/lib/i18n';

const metadata = { title: t('auth.login.success') };
---

<PageLayout metadata={metadata}>
  <div class="min-h-[60vh] flex items-center justify-center">
    <OAuthCallback client:load />
  </div>
</PageLayout>
