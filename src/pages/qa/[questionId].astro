---
import Layout from '~/layouts/SidebarLayout.astro';
import { Icon } from 'astro-icon/components';
import { getQuestionById, getAnswersByQuestionId, mockQuestions } from '~/features/qa/data/mock-questions';
import { communitySidebarLinks } from '~/features/shell/data/community-sidebar';
import { getPermalink } from '~/core/utils/permalinks';

export function getStaticPaths() {
  return mockQuestions.map((q) => ({ params: { questionId: q.id } }));
}

const { questionId } = Astro.params;
const question = getQuestionById(questionId || '');
const answers = getAnswersByQuestionId(questionId || '');

if (!question) {
  return Astro.redirect(getPermalink('/qa'));
}

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}

const metadata = { title: `${question.title} —— 理科迷` };
---

<Layout metadata={metadata} sidebarLinks={communitySidebarLinks} currentPath={getPermalink(`/qa/${questionId}`)}>
  <div class="space-y-6 max-w-3xl">
    <!-- 问题 -->
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span
          class={`text-xs px-2 py-0.5 rounded-full font-medium ${question.status === 'resolved' ? 'bg-green-100 dark:bg-green-950/30 text-green-500' : 'bg-yellow-100 dark:bg-yellow-950/30 text-yellow-500'}`}
        >
          {question.status === 'resolved' ? '已解决' : '待解决'}
        </span>
        {question.bounty > 0 && <span class="text-xs text-amber-500 font-medium">{question.bounty} 积分悬赏</span>}
      </div>
      <h1 class="text-2xl font-bold text-deep-text">{question.title}</h1>
      <div class="flex items-center gap-2 mt-2 text-sm text-text-muted/60">
        <span>{question.askerName}</span>
        <span>·</span>
        <span>{formatDate(question.createdAt)}</span>
        <span>·</span>
        <span>{question.viewCount} 浏览</span>
      </div>
      <div class="flex flex-wrap gap-1 mt-2">
        {question.tags.map((t) => <span class="text-xs px-2 py-0.5 rounded-full bg-primary/10 text-primary">{t}</span>)}
      </div>
      <div class="mt-4 p-4 bg-card-bg border border-surface-3 rounded-xl text-sm text-deep-text leading-relaxed">
        {question.content}
      </div>
    </div>

    <!-- 回答列表 -->
    <div>
      <h3 class="font-semibold text-deep-text mb-4">{answers.length} 个回答</h3>
      <div class="space-y-4">
        {
          answers.map((a) => (
            <div
              class="bg-card-bg border rounded-xl p-4"
              class:list={[
                { 'border-green-200 dark:border-green-900/30 bg-green-50 dark:bg-green-950/10': a.isAccepted },
                { 'border-surface-3': !a.isAccepted },
              ]}
            >
              {a.isAccepted && (
                <div class="text-xs text-green-500 font-medium mb-2 inline-flex items-center gap-1">
                  <Icon name="material-symbols:check-circle" class="w-3.5 h-3.5" /> 已采纳
                </div>
              )}
              <div class="text-sm text-deep-text leading-relaxed">{a.content}</div>
              <div class="flex items-center gap-3 mt-3 text-xs text-text-muted/60">
                <span>{a.authorName}</span>
                <span>{formatDate(a.createdAt)}</span>
                <span>{a.likeCount} 赞</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
