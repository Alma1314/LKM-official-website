---
import Layout from '~/layouts/BaseLayout.astro';
import MessagesPage from '~/features/anonymous-letter/pages/MessagesPage.vue';
import '~/features/anonymous-letter/styles/global.css';
import type { MetaData } from '~/core/types';
const metadata: MetaData = { title: '匿名回信 — 拾光树洞', description: '全程匿名，双方都不暴露真实身份。' };
---
<Layout metadata={metadata}><MessagesPage client:only="vue" /></Layout>

<script is:inline>
  (function () {
    var theme = localStorage.theme;
    var isDark = theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.classList.toggle('dark', isDark);
  })();
</script>
