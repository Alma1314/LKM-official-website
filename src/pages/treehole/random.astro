---
import Layout from '~/layouts/BaseLayout.astro';
import RandomPage from '~/features/anonymous-letter/pages/RandomPage.vue';
import '~/features/anonymous-letter/styles/global.css';
import type { MetaData } from '~/core/types';
const metadata: MetaData = { title: '随机树洞 — 拾光树洞', description: '抽一封陌生人的信，安静地读，温柔地回。' };
---
<Layout metadata={metadata}><RandomPage client:only="vue" /></Layout>

<script is:inline>
  (function () {
    var theme = localStorage.theme;
    var isDark = theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.classList.toggle('dark', isDark);
  })();
</script>
