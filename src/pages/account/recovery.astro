---
import PageLayout from '~/layouts/PageLayout.astro';

const metadata = { title: '密码找回' };
---

<PageLayout metadata={metadata}>
  <div></div>
</PageLayout>

<script is:inline>
  window.addEventListener('astro:page-load', () => {
    window.dispatchEvent(new CustomEvent('open-auth-modal', { detail: { view: 'recovery' } }));
  });
</script>
