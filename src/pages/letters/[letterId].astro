---
import LetterDetailPage from '~/features/anonymous-letter/components/LetterDetailPage.vue';
import { mockLetters } from '~/features/anonymous-letter/data/mock-letters';

export function getStaticPaths() {
  return mockLetters.map((l) => ({ params: { letterId: l.id } }));
}

const { letterId } = Astro.params;
---

<div class="bg-[#1a1a2e] min-h-screen">
  <div class="max-w-7xl mx-auto px-4 py-12">
    <LetterDetailPage client:only="vue" letterId={letterId || ''} />
  </div>
</div>
