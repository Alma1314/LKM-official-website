---
import Layout from '~/layouts/PageLayout.astro';
import type { MetaData } from '~/core/types';

const metadata: MetaData = {
  title: '其他应用',
  description: '理科迷社区的全部应用入口。',
};

const apps = [
  {
    name: 'StarHope 学习助手',
    desc: '本地优先的跨平台学习工具。题库管理、智能练习、AI 对话、文档阅读、考试模拟——一站式学习解决方案。',
    href: `${import.meta.env.BASE_URL}starhope`,
    icon: '📚',
  },
  {
    name: '拾光树洞',
    desc: '治愈文艺的匿名倾诉空间。把心事交给风，把秘密留给树洞。写信、漂流瓶、许愿墙、双向匿名回信。',
    href: `${import.meta.env.BASE_URL}treehole`,
    icon: '🌙',
  },
];
---

<Layout metadata={metadata}>
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">其他应用</h1>
    <p class="text-gray-500 dark:text-gray-400 mb-8">社区的全部应用服务入口。</p>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        apps.map((app) => (
          <a
            href={app.href}
            class="block p-6 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-primary/50 hover:shadow-md transition-all"
          >
            <div class="text-3xl mb-3">{app.icon}</div>
            <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-1">{app.name}</h2>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">{app.desc}</p>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
