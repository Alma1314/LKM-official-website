---
import BaseLayout from '~/layouts/BaseLayout.astro';

import { getPermalink } from '~/lib/utils/permalinks';

import BackgroundSwitcher from '~/features/shell/background/BackgroundSwitcher.astro';
import Hero from '~/features/homepage/components/Hero.astro';
import ShellLightDarkSwitch from '~/features/shell/components/LightDarkSwitch.vue';

import avatar七月花 from '../assets/images/member-optimized/七月花.webp';
import avatar七月O from '../assets/images/member-optimized/七月O.webp';
import avatar七月郁离 from '../assets/images/member-optimized/七月郁离.webp';
import avatar七月墨染 from '../assets/images/member-optimized/七月墨染.webp';
import avatar七月有枝 from '../assets/images/member-optimized/七月有枝.webp';

import Section from '~/features/homepage/components/Section.astro';
import BlogLatestPosts from '~/features/homepage/components/BlogLatestPosts.astro';
import FAQs from '~/features/homepage/components/FAQs.astro';
import ClockTimeline from '~/features/homepage/components/ClockTimeline.astro';
---

<BaseLayout>
  <div class="fixed top-4 right-16 z-50">
    <ShellLightDarkSwitch client:load />
  </div>

  <!-- Hero 部件 -->
  <Hero
    id="intro"
    actions={[
      {
        variant: 'primary',
        text: '博客',
        href: getPermalink('/blog'),
        target: '_self',
        icon: 'tabler:arrow-right',
      },
      {
        variant: 'primary',
        text: '文档',
        href: getPermalink('/blog'),
        target: '_self',
        icon: 'tabler:book',
      },
    ]}
  >
    <Fragment slot="bg">
      <BackgroundSwitcher />
    </Fragment>
    <Fragment slot="title">
      <div class="flex flex-col gap-4">
        <div
          class="text-[#6C2AD8] dark:text-primary text-[40px] md:text-[56px] font-semibold leading-[1.07] tracking-[-0.005em] [text-shadow:0_0_1px_var(--color-primary-content)]"
        >
          理科迷！
        </div>
        <div
          class="block mb-1 font-semibold tracking-[-0.005em] text-deep-text [text-shadow:0_0_1px_var(--color-base-content)]"
        >
          科技爱好者社区
        </div>
      </div>
    </Fragment>
    <Fragment slot="subtitle">
      <div class="inline-block bg-card-bg/30 backdrop-blur-md rounded-lg px-3 py-1 mb-2">
        <span class="text-[17px] font-normal text-text-muted leading-relaxed"> 是由广大科技爱好者组成的社区 </span>
      </div>
      <div class="sm:hidden bg-card-bg/30 backdrop-blur-md rounded-lg px-3 py-1.5">
        <span class="text-[13px] text-text-muted leading-relaxed">
          <strong class="font-semibold text-primary mr-1">Here!</strong>
          打破专业门槛，让每一位科技爱好者都能在这里找到同频的伙伴。
        </span>
      </div>
      <div class="hidden sm:inline-block bg-card-bg/30 backdrop-blur-md rounded-lg px-3 py-1.5">
        <span class="text-[14px] text-text-muted leading-relaxed">
          <strong class="font-semibold text-primary mr-1">Here!</strong>
          在这里，科学与技术都脱离了学术象牙塔的刻板与遥远……共探万物运转的奥秘。
        </span>
      </div>
    </Fragment>
  </Hero>

  <!-- ====== 仪表盘模块 ====== -->

  <!-- 快捷入口 -->
  <Section classes={{ container: 'bg-card-bg pb-8' }}>
    <div class="flex justify-center gap-4 flex-wrap">
      <a
        href="/files"
        class="flex flex-col items-center gap-2 px-6 py-4 rounded-xl bg-primary/5 hover:bg-primary/10 transition-colors group"
      >
        <span
          class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center group-hover:scale-110 transition-transform"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
            ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"
            ></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg
          >
        </span>
        <span class="text-sm font-medium text-deep-text">上传文件</span>
      </a>
      <a
        href="/forum"
        class="flex flex-col items-center gap-2 px-6 py-4 rounded-xl bg-primary/5 hover:bg-primary/10 transition-colors group"
      >
        <span
          class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center group-hover:scale-110 transition-transform"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
            ><path d="M12 20h9"></path><path
              d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"
            ></path></svg
          >
        </span>
        <span class="text-sm font-medium text-deep-text">发帖</span>
      </a>
      <a
        href="/qa/ask"
        class="flex flex-col items-center gap-2 px-6 py-4 rounded-xl bg-primary/5 hover:bg-primary/10 transition-colors group"
      >
        <span
          class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center group-hover:scale-110 transition-transform"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
            ><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line
              x1="12"
              y1="17"
              x2="12.01"
              y2="17"></line></svg
          >
        </span>
        <span class="text-sm font-medium text-deep-text">提问</span>
      </a>
      <a
        href="/contribution"
        class="flex flex-col items-center gap-2 px-6 py-4 rounded-xl bg-primary/5 hover:bg-primary/10 transition-colors group"
      >
        <span
          class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center group-hover:scale-110 transition-transform"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"><polyline points="20 6 9 17 4 12"></polyline></svg
          >
        </span>
        <span class="text-sm font-medium text-deep-text">打卡</span>
      </a>
    </div>
  </Section>

  {/* ===== 如下板块将由清汉维护 ===== */}
  <Section
    id="external-resources"
    title="资源网站"
    subtitle="以下为站外公开学术 / 教育平台，目前处于维护阶段"
    classes={{ container: '' }}
  >
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="https://iupac.org/" target="_blank" rel="noopener noreferrer" class="profile-card group">
          <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
            <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold"
              >IU</span
            >
            <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">IUPAC</h3>
            <p class="text-xs text-text-muted">国际纯粹与应用化学联合会</p>
          </div>
        </a>

        <a href="https://www.chemsoc.org.cn/" target="_blank" rel="noopener noreferrer" class="profile-card group">
          <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
            <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold"
              >CC</span
            >
            <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">中国化学会</h3>
            <p class="text-xs text-text-muted">全国化学学术组织</p>
          </div>
        </a>

        <a href="https://basic.smartedu.cn/" target="_blank" rel="noopener noreferrer" class="profile-card group">
          <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
            <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold"
              >教</span
            >
            <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">
              国家中小学智慧教育平台
            </h3>
            <p class="text-xs text-text-muted">教育部官方 · 全学段课程</p>
          </div>
        </a>

        <!-- Z-Library 单独警示 -->
        <a
          href="https://zh.z-library.sk/"
          target="_blank"
          rel="noopener noreferrer"
          class="profile-card group border border-dashed border-amber-400/60"
        >
          <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
            <span
              class="w-12 h-12 rounded-full bg-amber-400/10 flex items-center justify-center text-amber-600 font-bold"
              >Z</span
            >
            <h3 class="font-semibold text-deep-text group-hover:text-amber-600 transition-colors">Z-Library</h3>
            <p class="text-xs text-text-muted">全球最大电子图书馆之一，域名不定期更换，可能需要代理访问</p>
          </div>
        </a>

        <a
          href="https://pubchem.ncbi.nlm.nih.gov/"
          target="_blank"
          rel="noopener noreferrer"
          class="profile-card group"
        >
          <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
            <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold"
              >P</span
            >
            <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">NCBI PubChem</h3>
            <p class="text-xs text-text-muted">化学物质、分子式、专利、生物活性数据</p>
          </div>
        </a>

        <a href="https://www.iplant.cn/" target="_blank" rel="noopener noreferrer" class="profile-card group">
          <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
            <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold"
              >植</span
            >
            <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">植物智</h3>
            <p class="text-xs text-text-muted">植物百科、图库、中国植物志检索</p>
          </div>
        </a>

        <a href="https://www.bipm.org/" target="_blank" rel="noopener noreferrer" class="profile-card group">
          <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
            <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold"
              >B</span
            >
            <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">国际计量局 (BIPM)</h3>
            <p class="text-xs text-text-muted">国际单位制 SI 定义与度量衡标准</p>
          </div>
        </a>
      </div>
    </div>
  </Section>
  {/* ===== 截止至此处 ===== */}

  <!-- 推荐板块 -->
  <Section id="recommend" classes={{ container: '' }}>
    <div class="max-w-7xl mx-auto">
      <h2 class="text-2xl font-bold text-deep-text text-center mb-2">探索板块</h2>
      <p class="text-sm text-text-muted text-center mb-6">发现你感兴趣的内容</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/forum/basic-science" class="profile-card group">
          <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
            <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">⚛️</span>
            <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">基础学科</h3>
            <p class="text-xs text-text-muted">1.2k 成员 · 今日 45 帖</p>
          </div>
        </a>
        <a href="/forum/applied-science" class="profile-card group">
          <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
            <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">💻</span>
            <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">应用学科</h3>
            <p class="text-xs text-text-muted">890 成员 · 今日 32 帖</p>
          </div>
        </a>
        <a href="/forum/hobby" class="profile-card group">
          <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
            <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">✨</span>
            <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">兴趣板块</h3>
            <p class="text-xs text-text-muted">520 成员 · 今日 28 帖</p>
          </div>
        </a>
        <a href="/columns" class="profile-card group">
          <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
            <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">📖</span>
            <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">专栏</h3>
            <p class="text-xs text-text-muted">深度长文 · 专业认证</p>
          </div>
        </a>
      </div>
    </div>
  </Section>

  <!-- 团队成员 -->
  <Section title="团队成员" subtitle="理科迷因为有你，所以更加精彩" id="team" classes={{ container: 'bg-card-bg' }}>
    <div class="grid gap-5 md:gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        [
          { name: '七月O', desc: '中国科学院国家天文台博士，引力波与黑洞物理方向', avatar: avatar七月O },
          { name: '七月花', desc: '一个有理想的博士，梦想：每个孩子都能接触科学', avatar: avatar七月花 },
          { name: '七月墨染', desc: '双非物理，卧薪尝胆三千日，大雪深埋终成金', avatar: avatar七月墨染 },
          { name: '七月郁离', desc: '群务组组长，群务无小事，用心皆风景', avatar: avatar七月郁离 },
          { name: '七月有枝', desc: '前活动策划组组员，且停且忘且随风，且行且看且从容', avatar: avatar七月有枝 },
        ].map((m) => (
          <a href={getPermalink('/team')} class="profile-card ">
            <div class="profile-inner p-4 sm:p-5 flex flex-row items-center gap-3 sm:flex-col sm:items-center text-left sm:text-center rounded-lg">
              <img
                src={m.avatar.src}
                alt={m.name}
                width={96}
                height={96}
                class="w-10 h-10 sm:w-16 sm:h-16 rounded-full object-cover shrink-0 sm:mb-3"
                loading="lazy"
                decoding="async"
              />
              <div class="flex-1 min-w-0">
                <h3 class="font-bold text-lg text-deep-text">{m.name}</h3>
                <p class="text-xs text-text-muted mt-1">{m.desc}</p>
              </div>
            </div>
          </a>
        ))
      }
      <a href={getPermalink('/team')} class="profile-card">
        <div
          class="profile-inner p-4 sm:p-5 flex flex-col items-center justify-center text-center gap-3 min-h-full rounded-lg"
        >
          <span class="text-lg font-bold text-deep-text">更多成员</span>
          <span class="text-xs text-text-muted">点击查看完整管理团队</span>
          <span
            class="inline-flex items-center justify-center rounded-full px-5 py-2 text-sm font-semibold leading-6 text-on-primary bg-primary"
            >查看全部 →</span
          >
        </div>
      </a>
    </div>
  </Section>

  <!-- 发展历程 -->
  <Section title="发展历程" subtitle="物换星移，春秋代序" id="timeline">
    <ClockTimeline
      items={[
        {
          year: '2014.08.01',
          title: '可琪创立理科迷',
          description: '可琪创建了第一个群聊——〔理科迷宅基地〕……',
          iconName: 'tabler:star',
        },
        {
          year: '2014 ~ 2016',
          title: '群组扩张，与百度贴吧建立联系',
          description: '理科迷群组进入快速扩张期……',
          iconName: 'tabler:users-plus',
        },
        {
          year: '2015 ~ 2016',
          title: '学科分群体系建立',
          description: '数学、物理、化学、生物等分群陆续创立……',
          iconName: 'tabler:folders',
        },
        {
          year: '2016',
          title: '兴趣群组持续扩展',
          description: '信息技术群、科技世界群、心理学群相继建立……',
          iconName: 'tabler:puzzle',
        },
        {
          year: '2017 ~ 2018',
          title: '网站规划与新闻社构想',
          description: '线上网站曾有过规划并短暂试运行……',
          iconName: 'tabler:file-text',
        },
        {
          year: '2018',
          title: '创始人淡出，花花接续坚守',
          description: '可琪因学业原因逐渐淡出……',
          iconName: 'tabler:shield-check',
        },
        {
          year: '2018.02',
          title: '七月团队早期架构建立',
          description: '群务组与总务组成立……',
          iconName: 'tabler:building-community',
        },
        {
          year: '2019.08.15',
          title: '千寻入群，短暂回暖',
          description: '千寻加入理科迷群聊……',
          iconName: 'tabler:user-plus',
        },
        { year: '2020', title: '再度沉寂', description: '千寻备战中考……', iconName: 'tabler:user-minus' },
        {
          year: '2024.04.19',
          title: '群管理的呼唤',
          description: '群人数跌破 800……',
          iconName: 'tabler:message-heart',
        },
        {
          year: '2024.07.30',
          title: '启动重建计划',
          description: '正式下定决心重建理科迷……',
          iconName: 'tabler:rocket',
        },
        {
          year: '2024.08.10',
          title: '官方账号走红',
          description: '首条视频获 7800+ 播放……',
          iconName: 'tabler:brand-youtube',
        },
        { year: '2025.01.08', title: '官方群组重组', description: '初高中分群重建……', iconName: 'tabler:users-group' },
        { year: '2025.04', title: '官网文档库建设', description: '开始建设官网文档库……', iconName: 'tabler:database' },
        {
          year: '2025.04.02',
          title: '活动策划部成立',
          description: '七月团队活动策划部成立……',
          iconName: 'tabler:calendar-event',
        },
        {
          year: '2025.07 ~ 08',
          title: '第一次暑假活动落地',
          description: '首次暑假活动雏形落地……',
          iconName: 'tabler:sun',
        },
        {
          year: '2025.08.04',
          title: '网站遭删库',
          description: '所有数据丢失，惨痛教训。',
          iconColor: 'text-red-500',
          iconName: 'tabler:alert-triangle',
        },
        { year: '2026.06', title: '涅槃重生', description: '以更稳健架构重建官网……', iconName: 'tabler:refresh' },
      ]}
    />
  </Section>

  <BlogLatestPosts id="update" title="最近更新" information="如果不知道看什么，可以阅读这些文档来熟悉我们！" />

  <FAQs
    id="faq"
    title="常见问题"
    subtitle="以下整理了用户关于 LKM 官方网站的常见疑问"
    classes={{ container: 'max-w-4xl mx-auto' }}
    items={[
      { title: '理科迷是什么？', description: '理科迷是一个由科技爱好者组成的社区……' },
      { title: '如何加入理科迷？', description: '可通过官方 QQ 群加入……' },
      { title: '理科迷有哪些活动？', description: '定期举办假期活动、研讨会……' },
      { title: '如何参与社区建设？', description: '可加入管理团队或项目组……' },
      { title: '有问题怎么联系？', description: '通过联系页面或直接在 QQ 群反馈。' },
    ]}
  />
</BaseLayout>
