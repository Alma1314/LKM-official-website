---
import Layout from '~/layouts/PageLayout.astro';
import { ContributionPage } from '~/features/contribution';
import { t } from '~/lib/i18n';

const metadata = { title: t('page.official.contribution.metaTitle') };
---

<Layout metadata={metadata}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8" style="min-height: 400px">
    <ContributionPage client:load />
  </div>
</Layout>
