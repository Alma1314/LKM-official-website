---
import MainGridLayout from '~/layouts/BlogMainGridLayout.astro';
import { getUserByUsername, mockUsers, ProfilePage } from '~/features/profile';
import { getPermalink } from '~/core/utils/permalinks';

export function getStaticPaths() {
  return mockUsers.map((u) => ({ params: { username: u.username } }));
}

const { username } = Astro.params;
const user = getUserByUsername(username || '');

if (!user) {
  return Astro.redirect(getPermalink('/'));
}
---

<MainGridLayout title={user.displayName} description={user.bio}>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <ProfilePage client:load user={user} />
    </div>
  </div>
</MainGridLayout>
