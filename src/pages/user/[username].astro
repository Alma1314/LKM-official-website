---
import MainGridLayout from '~/layouts/BlogMainGridLayout.astro';
import { getUserByUsername, ProfilePage, UserProfile } from '~/features/profile';
import { getPermalink } from '~/lib/utils/permalinks';

const { username } = Astro.params;

// 先从 mock 数据查找，找不到则允许渲染（客户端 Vue 组件会从 Pinia store 获取真实数据）
const user = getUserByUsername(username || '');
const isMockUser = !!user;
const displayName = user?.displayName || username;
const bio = user?.bio || '';
---

<MainGridLayout title={displayName} description={bio}>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      {isMockUser ? (
        <ProfilePage client:load user={user} />
      ) : (
        <UserProfile client:only="vue" username={username} />
      )}
    </div>
  </div>
</MainGridLayout>
