---
import OfficialLayout from '~/layouts/OfficialLayout.astro';
import Section from '~/features/homepage/components/Section.astro';
import { getPermalink } from '~/lib/utils/permalinks';
---

<OfficialLayout metadata={{ title: '资源' }}>
  <div class="max-w-6xl mx-auto py-12 px-4">
    <a href={getPermalink('/')} class="inline-flex items-center gap-1 text-sm text-primary hover:underline mb-6"> ← 返回首页 </a>

    <h1 class="text-3xl font-bold text-deep-text text-center mb-2">延伸资源网站</h1>
    <p class="text-sm text-text-muted text-center mb-10">
      以下为站外公开学术 / 教育平台，内容由第三方提供，访问请自行甄别，这个排版先这么凑合着用
    </p>

    <Section
      id="external-resources"
      title="资源网站"
      subtitle="目前由我（清汉）维护，如有投稿请联系我"
      classes={{ container: '' }}
    >
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- IUPAC -->
          <a href="https://iupac.org/" target="_blank" rel="noopener noreferrer" class="profile-card group">
            <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
              <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold"
                >IU</span
              >
              <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">IUPAC</h3>
              <p class="text-xs text-text-muted">国际纯粹与应用化学联合会</p>
            </div>
          </a>

          <!-- 中国化学会 -->
          <a href="https://www.chemsoc.org.cn/" target="_blank" rel="noopener noreferrer" class="profile-card group">
            <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
              <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold"
                >CC</span
              >
              <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">中国化学会</h3>
              <p class="text-xs text-text-muted">全国化学学术组织</p>
            </div>
          </a>

          <!-- 国家中小学智慧教育平台 -->
          <a href="https://basic.smartedu.cn/" target="_blank" rel="noopener noreferrer" class="profile-card group">
            <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
              <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold"
                >教</span
              >
              <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">
                国家中小学智慧教育平台
              </h3>
              <p class="text-xs text-text-muted">教育部官方 · 全学段课程</p>
            </div>
          </a>

          <!-- Z-Library -->
          <details class="group profile-card open:border-amber-400/70">
            <summary
              class="list-none cursor-pointer p-5 flex flex-col items-center text-center gap-2 focus:outline-none select-none relative"
            >
              <span
                class="absolute top-3 right-3 text-amber-500 text-[10px] opacity-60 group-open:rotate-180 transition-transform"
                >▼</span
              >
              <span
                class="w-12 h-12 rounded-full bg-amber-400/10 flex items-center justify-center text-amber-600 font-bold text-xl"
                >Z</span
              >
              <h3 class="font-semibold text-deep-text group-hover:text-amber-600 transition-colors">Z-Library</h3>
              <p class="text-xs text-text-muted">需梯子 · 域名可能变动</p>
            </summary>
            <div class="px-5 pb-5 pt-1 flex flex-col gap-3">
              <a
                href="https://zh.z-library.sk/"
                target="_blank"
                rel="noopener noreferrer"
                class="block rounded-lg px-4 py-2.5 text-sm font-medium text-center bg-amber-500/10 text-amber-700 dark:text-amber-300 hover:bg-amber-500/20"
              >
                官网入口（由于当前 .sk 域名不稳定，zlib在大陆时不时会遭到封锁，若访问不稳定，请更换时段访问）
              </a>
              <a
                href="https://zh.101ml.by/"
                target="_blank"
                rel="noopener noreferrer"
                class="block rounded-lg px-4 py-2.5 text-sm font-medium text-center border border-dashed border-amber-400/50 text-amber-700 dark:text-amber-300 hover:bg-amber-500/10"
              >
                备用镜像站 · 且用且珍惜，如无法打开/域名过时，请及时联系站点维护人员更换
              </a>
            </div>
          </details>

          <!-- PubChem -->
          <a
            href="https://pubchem.ncbi.nlm.nih.gov/"
            target="_blank"
            rel="noopener noreferrer"
            class="profile-card group"
          >
            <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
              <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold"
                >P</span
              >
              <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">NCBI PubChem</h3>
              <p class="text-xs text-text-muted">化学 / 分子式 / 生物活性</p>
            </div>
          </a>

          <!-- 植物智 -->
          <a href="https://www.iplant.cn/" target="_blank" rel="noopener noreferrer" class="profile-card group">
            <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
              <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold"
                >植</span
              >
              <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">植物智</h3>
              <p class="text-xs text-text-muted">中国植物志 / 物种检索</p>
            </div>
          </a>

          <!-- BIPM -->
          <a href="https://www.bipm.org/" target="_blank" rel="noopener noreferrer" class="profile-card group">
            <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
              <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold"
                >B</span
              >
              <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">国际计量局 (BIPM)</h3>
              <p class="text-xs text-text-muted">SI 国际单位制标准</p>
            </div>
          </a>

          <!-- 维基百科（顺手帮你换成中文入口，gpe 是加纳皮钦版） -->
          <a
            href="https://gpe.wikipedia.org/wiki/Main_Page"
            target="_blank"
            rel="noopener noreferrer"
            class="profile-card group"
          >
            <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
              <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold"
                >W</span
              >
              <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">
                维基百科（默认为英文维基）
              </h3>
              <p class="text-xs text-text-muted">（请合理利用）</p>
            </div>
          </a>
        </div>
      </div>
    </Section>
  </div>
</OfficialLayout>

<!-- 2026/8/11 资源网站板块独立  清汉 -->
