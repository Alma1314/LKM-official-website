---
import { AdminLayout, adminFiles } from '~/features/admin';
---

<AdminLayout>
  <h1 class="text-2xl font-bold text-deep-text mb-6">文件审核</h1>
  <div class="flex gap-2 mb-4">
    <button class="px-3 py-1.5 rounded-lg text-sm font-medium bg-primary text-on-primary">全部</button>
    <button class="px-3 py-1.5 rounded-lg text-sm font-medium bg-surface-3 text-text-muted">待审核</button>
    <button class="px-3 py-1.5 rounded-lg text-sm font-medium bg-surface-3 text-text-muted">已通过</button>
    <button class="px-3 py-1.5 rounded-lg text-sm font-medium bg-surface-3 text-text-muted">已驳回</button>
  </div>
  <div class="bg-card-bg border border-surface-3 rounded-xl overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-surface-3/50">
        <tr>
          <th class="text-left px-4 py-3 font-medium text-text-muted">文件名</th>
          <th class="text-left px-4 py-3 font-medium text-text-muted hidden sm:table-cell">上传者</th>
          <th class="text-left px-4 py-3 font-medium text-text-muted hidden md:table-cell">大小</th>
          <th class="text-left px-4 py-3 font-medium text-text-muted">状态</th>
          <th class="text-left px-4 py-3 font-medium text-text-muted">操作</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-surface-3">
        {
          adminFiles.map((f) => (
            <tr class="hover:bg-page-bg transition-colors">
              <td class="px-4 py-3">
                <>
                  <div class="font-medium text-deep-text line-clamp-1 max-w-56">{f.originalName}</div>
                  <div class="text-xs text-text-muted/60">
                    {f.categoryName} · {f.createdAt}
                  </div>
                </>
              </td>
              <td class="px-4 py-3 hidden sm:table-cell text-text-muted">{f.uploaderName}</td>
              <td class="px-4 py-3 hidden md:table-cell text-text-muted">{f.size}</td>
              <td class="px-4 py-3">
                <span
                  class="text-xs px-2 py-0.5 rounded-full font-medium"
                  class:list={[
                    { 'bg-yellow-100 dark:bg-yellow-950/30 text-yellow-500': f.status === 'pending' },
                    { 'bg-green-100 dark:bg-green-950/30 text-green-500': f.status === 'approved' },
                    { 'bg-red-100 dark:bg-red-950/30 text-red-500': f.status === 'rejected' },
                  ]}
                >
                  {f.status === 'pending' ? '审核中' : f.status === 'approved' ? '已通过' : '已驳回'}
                </span>
              </td>
              <td class="px-4 py-3">
                {f.status === 'pending' ? (
                  <div class="flex gap-1">
                    <button class="text-xs text-green-500 hover:underline">通过</button>
                    <button class="text-xs text-red-500 hover:underline">驳回</button>
                  </div>
                ) : (
                  <span class="text-xs text-text-muted/60">—</span>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</AdminLayout>
