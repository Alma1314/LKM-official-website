---
import AdminLayout from '~/features/admin/components/AdminLayout.astro';
import { Icon } from 'astro-icon/components';
import { adminStats } from '~/features/admin/data/mock-admin';

---


<AdminLayout>
  <h1 class="text-2xl font-bold text-deep-text mb-6">仪表盘</h1>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    {
      adminStats.map((stat) => (
        <div class="bg-card-bg border border-surface-3 rounded-xl p-5">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
              <Icon name={stat.icon} class="w-5 h-5 text-primary" />
            </span>
            <div>
              <div class="text-2xl font-bold text-deep-text">{stat.value.toLocaleString()}</div>
              {stat.change && <div class="text-xs text-green-500">{stat.change}</div>}
            </div>
          </div>
          <div class="text-sm text-text-muted">{stat.label}</div>
        </div>
      ))
    }
  </div>

  <div class="bg-card-bg border border-surface-3 rounded-xl p-6">
    <h2 class="text-lg font-semibold text-deep-text mb-4">最近待处理</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="p-4 rounded-lg bg-yellow-50 dark:bg-yellow-950/10 border border-yellow-200 dark:border-yellow-900/30">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-medium text-deep-text">待审核文件</span><span
            class="text-lg font-bold text-yellow-500">12</span
          >
        </div>
        <p class="text-xs text-text-muted">芯片设计入门教程.pdf 等 12 个文件等待审核</p>
      </div>
      <div class="p-4 rounded-lg bg-red-50 dark:bg-red-950/10 border border-red-200 dark:border-red-900/30">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-medium text-deep-text">待处理举报</span><span class="text-lg font-bold text-red-500"
            >3</span
          >
        </div>
        <p class="text-xs text-text-muted">包含垃圾广告、人身攻击等举报</p>
      </div>
      <div class="p-4 rounded-lg bg-blue-50 dark:bg-blue-950/10 border border-blue-200 dark:border-blue-900/30">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-medium text-deep-text">被标记帖子</span><span
            class="text-lg font-bold text-blue-500">2</span
          >
        </div>
        <p class="text-xs text-text-muted">2 篇帖子被标记为违规内容</p>
      </div>
    </div>
  </div>
</AdminLayout>
