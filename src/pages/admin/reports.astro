---
import { AdminLayout, adminReports } from '~/features/admin';
import { t } from '~/lib/i18n';
---

<AdminLayout>
  <h1 class="text-2xl font-bold text-deep-text mb-6">{t('page.admin.reports.title')}</h1>
  <div class="bg-card-bg border border-surface-3 rounded-xl overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-surface-3/50">
        <tr>
          <th class="text-left px-4 py-3 font-medium text-text-muted">{t('page.admin.reports.target')}</th>
          <th class="text-left px-4 py-3 font-medium text-text-muted hidden sm:table-cell"
            >{t('page.admin.reports.type')}</th
          >
          <th class="text-left px-4 py-3 font-medium text-text-muted hidden md:table-cell"
            >{t('page.admin.reports.reporter')}</th
          >
          <th class="text-left px-4 py-3 font-medium text-text-muted">{t('page.admin.reports.reason')}</th>
          <th class="text-left px-4 py-3 font-medium text-text-muted">{t('page.admin.reports.actions')}</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-surface-3">
        {
          adminReports.map((r) => (
            <tr class="hover:bg-page-bg transition-colors">
              <td class="px-4 py-3">
                <>
                  <span class="font-medium text-deep-text">{t(r.targetTitle)}</span>
                  <div class="text-xs text-text-muted/60">{r.createdAt}</div>
                </>
              </td>
              <td class="px-4 py-3 hidden sm:table-cell">
                <span class="text-xs px-2 py-0.5 rounded-full bg-surface-3 text-text-muted">
                  {r.type === 'post'
                    ? t('page.admin.reports.post')
                    : r.type === 'comment'
                      ? t('page.admin.reports.comment')
                      : t('page.admin.reports.file')}
                </span>
              </td>
              <td class="px-4 py-3 hidden md:table-cell text-text-muted">{t(r.reporterName)}</td>
              <td class="px-4 py-3 text-text-muted">{t(r.reason)}</td>
              <td class="px-4 py-3">
                <div class="flex gap-1">
                  <>
                    <button class="text-xs text-green-500 hover:underline">{t('page.admin.reports.handle')}</button>
                    <button class="text-xs text-red-500 hover:underline">{t('page.admin.reports.reject')}</button>
                  </>
                </div>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</AdminLayout>
