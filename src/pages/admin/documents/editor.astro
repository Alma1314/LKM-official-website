---
import PageLayout from '~/layouts/PageLayout.astro';
import { EditorMount, persistence } from '~/features/editor';
import { getPermalink } from '~/lib/utils/permalinks';

const metadata = {
  title: '编辑文档 — LKM',
  description: 'LKM 管理后台 — 文档编辑',
};
---

<PageLayout metadata={metadata}>
  <div class="section-container max-w-4xl mx-auto py-8 px-4">
    <div class="mb-4 flex items-center gap-3">
      <a href={getPermalink('/admin/documents')} class="btn btn-ghost btn-sm gap-1">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        返回列表
      </a>
    </div>
    <div class="flex items-center justify-center min-h-[60vh] border border-surface-3 rounded-lg bg-card-bg">
      <div class="text-center">
        <p class="text-deep-text/50 text-lg mb-2">编辑器模块暂未加载</p>
        <p class="text-deep-text/30 text-sm">@lkm/rich-text-editor 和 @lkm/editor-persistence 包已移除，待重新实现后恢复。</p>
      </div>
    </div>
  </div>
</PageLayout>
