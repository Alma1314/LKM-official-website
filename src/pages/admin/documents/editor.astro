---
import PageLayout from '~/layouts/PageLayout.astro';
import { EditorMount, persistence } from '~/features/editor';

const metadata = {
  title: '编辑文档 — LKM',
  description: 'LKM 管理后台 — 文档编辑',
};
---

<PageLayout metadata={metadata}>
  <div class="section-container max-w-4xl mx-auto py-8 px-4">
    <div class="mb-4 flex items-center gap-3">
      <a href="/admin/documents" class="btn btn-ghost btn-sm gap-1">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        返回列表
      </a>
    </div>
    <EditorMount client:only="react" adapter={persistence}>
      <div
        slot="fallback"
        class="flex items-center justify-center min-h-[60vh] border border-surface-3 rounded-lg bg-card-bg"
      >
        <span class="loading loading-spinner loading-md mr-2"></span>
        <span class="text-deep-text/50">正在加载编辑器……</span>
      </div>
    </EditorMount>
  </div>
</PageLayout>
