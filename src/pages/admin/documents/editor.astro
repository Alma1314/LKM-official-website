---
import PageLayout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/lib/utils/permalinks';

const metadata = {
  title: '编辑文档 — LKM',
  description: 'LKM 管理后台 — 文档编辑',
};
---

<PageLayout metadata={metadata}>
  <div class="section-container max-w-4xl mx-auto py-8 px-4">
    <div class="mb-4 flex items-center gap-3">
      <a href={getPermalink('/admin/documents')} class="btn btn-ghost btn-sm gap-1">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        返回列表
      </a>
    </div>
    <div id="editor-root" class="min-h-[60vh]">
      <div class="flex items-center justify-center min-h-[60vh]">
        <span class="loading loading-spinner loading-md"></span>
        <span class="ml-2 text-deep-text/50">正在加载编辑器……</span>
      </div>
    </div>
  </div>
</PageLayout>

<script>
  import { createRoot } from 'react-dom/client';
  import { createElement } from 'react';
  import EditorMount from '~/features/editor/components/core/EditorMount';
  import { createLocalPersistence } from '~/features/editor/persistence/index';

  const rootEl = document.getElementById('editor-root');
  if (rootEl) {
    const root = createRoot(rootEl);
    root.render(createElement(EditorMount, { adapter: createLocalPersistence() }));
  }
</script>
