---
import Layout from '~/layouts/CommunityLayout.astro';
import { ssrFetch, logSsrError } from '~/lib/fetch-ssr';
import { categoryLabel } from '~/lib/api/modules/official-articles';
import type { OfficialArticle, OfficialArticleListData } from '~/lib/api/modules/official-articles';
import { t } from '~/lib/i18n';

const PAGE_SIZE = 20;

// 读 ?page= 分页参数，默认第 1 页
const rawPage = Astro.url.searchParams.get('page');
const page = Math.max(1, Number.parseInt(rawPage ?? '1', 10) || 1);

const { data, error } = await ssrFetch<OfficialArticleListData>(
  `/api/v1/articles?page=${page}&page_size=${PAGE_SIZE}`,
  { fallback: { items: [], total: 0 } },
);
logSsrError('博客列表', error);

const articles = (data?.items ?? []) as OfficialArticle[];
const total = data?.total ?? 0;
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

// 服务端确定日期文本，客户端无需再计算、无水合差异
function formatDate(d: string): string {
  return new Date(d).toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const metadata = { title: `${t('nav.blog')} —— LKM` };
---

<Layout metadata={metadata} navItems={['nav.community', 'nav.blog', 'nav.resources', 'nav.mine']}>
  <div class="max-w-3xl mx-auto py-10 px-4">
    <h1 class="text-3xl font-bold text-deep-text mb-6">{t('nav.blog')}</h1>

    {
      (!articles || articles.length === 0) && (
        <p class="text-text-muted text-center py-8">
          {error ? t('officialArticles.loadFailed', { error }) : t('officialArticles.empty')}
        </p>
      )
    }

    {
      articles.length > 0 && (
        <ul class="space-y-5">
          {articles.map((article) => (
            <li>
              <article class="bg-card-bg border border-surface-3 rounded-lg p-5 shadow-sm transition hover:border-primary hover:shadow-lg group">
                {article.cover && (
                  <a href={`/blog/posts/${article.slug}`} class="block mb-3">
                    <img
                      src={article.cover}
                      alt={article.title}
                      class="w-full aspect-[16/6] object-cover rounded-md bg-surface-3 group-hover:opacity-90 transition-opacity"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                )}

                <header>
                  <div class="mb-1.5">
                    <span class="text-sm text-text-muted">
                      <time datetime={article.published}>{formatDate(article.published)}</time>
                      {article.category && (
                        <>
                          {' · '}
                          <span class="font-medium">{categoryLabel(article.category)}</span>
                        </>
                      )}
                    </span>
                  </div>
                  <h2 class="text-lg sm:text-xl font-bold leading-tight mb-2 font-heading text-deep-text">
                    <a class="inline-block hover:text-primary transition ease-in duration-200" href={`/blog/posts/${article.slug}`}>
                      {article.title}
                    </a>
                  </h2>
                </header>

                {article.description && (
                  <p class="text-text-muted text-sm sm:text-base">{article.description}</p>
                )}
              </article>
            </li>
          ))}
        </ul>
      )
    }

    {
      totalPages > 1 && (
        <nav class="mt-10 flex items-center justify-center gap-2" aria-label={t('blog.articleCount', { count: total })}>
          {
            page > 1 && (
              <a
                href={`/blog?page=${page - 1}`}
                class="px-3 py-1.5 rounded border border-surface-3 text-sm hover:border-primary hover:text-primary transition-colors"
              >
                {t('blog.prev')}
              </a>
            )
          }

          <div class="flex items-center gap-1">
            {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
              <a
                href={`/blog?page=${p}`}
                aria-current={p === page ? 'page' : undefined}
                class={
                  p === page
                    ? 'px-3 py-1.5 rounded text-sm bg-primary text-surface-0 font-semibold'
                    : 'px-3 py-1.5 rounded border border-surface-3 text-sm hover:border-primary hover:text-primary transition-colors'
                }
              >
                {p}
              </a>
            ))}
          </div>

          {
            page < totalPages && (
              <a
                href={`/blog?page=${page + 1}`}
                class="px-3 py-1.5 rounded border border-surface-3 text-sm hover:border-primary hover:text-primary transition-colors"
              >
                {t('blog.next')}
              </a>
            )
          }
        </nav>
      )
    }
  </div>
</Layout>
