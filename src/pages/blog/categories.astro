---
// 博客分类页（SSR）：读 /api/v1/articles/categories 渲染分类卡片列表。
import Layout from '~/layouts/CommunityLayout.astro';
import { ssrFetch, logSsrError } from '~/lib/fetch-ssr';
import type { OfficialArticleCategory } from '~/lib/api/modules/official-articles';
import { t } from '~/lib/i18n';

const { data, error } = await ssrFetch<{ items: OfficialArticleCategory[] }>(
  '/api/v1/articles/categories',
  { fallback: { items: [] } },
);
logSsrError('博客分类', error);

const categories = data?.items ?? [];
const metadata = { title: `${t('blog.categoriesTitle')} —— LKM` };
---

<Layout metadata={metadata} navItems={['nav.community', 'nav.blog', 'nav.resources', 'nav.mine']}>
  <div class="max-w-3xl mx-auto py-10 px-4">
    <h1 class="text-3xl font-bold text-deep-text mb-6">{t('blog.categoriesTitle')}</h1>

    {
      categories.length === 0 && (
        <p class="text-text-muted text-center py-8">
          {error ? t('officialArticles.loadFailed', { error }) : t('officialArticles.empty')}
        </p>
      )
    }

    {
      categories.length > 0 && (
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {categories.map((cat) => (
            <a
              href="/blog"
              class="border border-surface-3 rounded-lg p-6 hover:shadow-md hover:border-primary transition-shadow"
            >
              <h2 class="text-lg font-semibold text-deep-text">{cat.name}</h2>
              <p class="text-text-muted text-sm mt-1">
                {t('blog.categoryArticleCount', { count: cat.article_count })}
              </p>
            </a>
          ))}
        </div>
      )
    }
  </div>
</Layout>
