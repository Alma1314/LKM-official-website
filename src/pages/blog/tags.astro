---
// 博客标签页（SSR）：读 /api/v1/articles/tags 渲染标签药丸列表。
import Layout from '~/layouts/CommunityLayout.astro';
import { ssrFetch, logSsrError } from '~/lib/fetch-ssr';
import { t } from '~/lib/i18n';

interface BlogTagItem {
  name: string;
  article_count: number;
}

const { data, error } = await ssrFetch<{ items: BlogTagItem[] }>(
  '/api/v1/articles/tags',
  { fallback: { items: [] } },
);
logSsrError('博客标签', error);

const tags = data?.items ?? [];
const metadata = { title: `${t('blog.tagsTitle')} —— LKM` };
---

<Layout metadata={metadata} navItems={['nav.community', 'nav.blog', 'nav.resources', 'nav.mine']}>
  <div class="max-w-3xl mx-auto py-10 px-4">
    <h1 class="text-3xl font-bold text-deep-text mb-6">{t('blog.tagsTitle')}</h1>

    {
      tags.length === 0 && (
        <p class="text-text-muted text-center py-8">
          {error ? t('officialArticles.loadFailed', { error }) : t('officialArticles.empty')}
        </p>
      )
    }

    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-3">
          {tags.map((tag) => (
            <a
              href="/blog"
              class="bg-surface-3 hover:bg-primary/10 hover:text-primary px-4 py-2 rounded-full text-sm transition-colors"
            >
              {tag.name} ({tag.article_count})
            </a>
          ))}
        </div>
      )
    }
  </div>
</Layout>
