---
import Layout from '~/layouts/CommunityLayout.astro';
import ArticleLikeButton from '~/features/blog-community/components/ArticleLikeButton.vue';
import ArticleComments from '~/features/blog-community/components/ArticleComments.vue';
import BlogShare from '~/features/blog-community/components/BlogShare.vue';
import { ssrFetch, logSsrError } from '~/lib/fetch-ssr';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import { preprocessEditorMdx } from '~/lib/markdown-plugins/preprocess-editor-mdx.mjs';
import type { ArticleDetail } from '~/lib/api';
import { t } from '~/lib/i18n';

const { slug } = Astro.params as { slug: string };

const { data: article, error } = await ssrFetch<ArticleDetail>(
  `/api/v1/articles/${slug}`,
  { fallback: null },
);
logSsrError(`博客文章 ${slug}`, error);

if (error || !article) {
  return new Response(
    `<div class="max-w-2xl mx-auto py-20 text-center">
      <h1 class="text-2xl font-bold mb-2">${t('blog.postNotFound')}</h1>
      <p class="text-text-muted mb-4">${error || t('blog.postNotExist')}</p>
    </div>`,
    { status: 404, headers: { 'Content-Type': 'text/html' } },
  );
}

const processor = await createMarkdownProcessor();
// content 是编辑器导出的 MDX（含自闭合 <Callout/>、<Figure/> JSX），markdown 处理器无法正确解析，
// 先用预处理器转成闭合良好的 .lkm-* HTML 再渲染，避免 JSX 被当未闭合容器吞掉正文。
const rendered = await processor.render(preprocessEditorMdx(article.content));
const metadata = { title: `${article.title} —— LKM` };

function formatDate(d: string): string {
  return new Date(d).toLocaleDateString('zh-CN', {
    year: 'numeric', month: 'long', day: 'numeric',
  });
}

// 分享完整 URL（供 BlogShare 使用）
const shareUrl = Astro.url.href;
---

<Layout metadata={metadata} navItems={['nav.community', 'nav.blog', 'nav.resources', 'nav.mine']}>
  <article class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold mb-2">{article.title}</h1>
    <p class="text-gray-500 mb-4">{formatDate(article.published)} · {t('blog.readingMeta', { words: '', minutes: article.reading_time })}</p>
    {article.category && <span class="text-xs px-2 py-0.5 rounded bg-blue-100 text-blue-700">{article.category}</span>}
    {article.tags?.map((tag: string) => (
      <span class="text-xs px-2 py-0.5 rounded bg-gray-100 text-gray-600 mr-1">{tag}</span>
    ))}
    {article.cover && <img src={article.cover} alt={article.title} class="w-full rounded-lg my-4" />}
    <div class="prose max-w-none my-8">
      <Fragment set:html={rendered.code} />
    </div>

    <!-- 点赞 / 分享 / 评论（客户端水合，SSR 首屏输出静态正文 + 点赞初值初始计数） -->
    <section class="mt-8 border-t border-border pt-6">
      <div class="flex items-center gap-4 mb-6">
        <ArticleLikeButton
          client:visible
          slug={slug}
          initialCount={article.likes}
        />
        <BlogShare client:visible url={shareUrl} title={article.title} />
      </div>
      <ArticleComments client:visible slug={slug} />
    </section>
  </article>
</Layout>
