---
import { Icon } from 'astro-icon/components';

export interface Props {
  icon?: string;
  title?: string;
  description?: string;
}

const {
  icon = 'tabler:info-square',
  title = await Astro.slots.render('title'),
  description = await Astro.slots.render('description'),
} = Astro.props;
---

<section class="bg-[var(--page-bg)] border border-[var(--surface-3)] not-prose">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 text-[17px] text-center text-[var(--deep-text)]">
    <Icon name={icon} class="w-4 h-4 inline-block align-text-bottom text-[var(--primary)]" />
    <span class="font-semibold" set:html={title} />
    <Fragment set:html={description} />
  </div>
</section>
