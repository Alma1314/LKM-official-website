---
import type { ImageMetadata } from 'astro';

export interface Props {
  name: string;
  avatar?: ImageMetadata;
  role?: string;
  desc?: string;
  dream?: string;
  quote?: string;
  size?: 'sm' | 'lg';
}

const { name, avatar, role, desc, dream, quote, size = 'sm' } = Astro.props;
const isLg = size === 'lg';
---

<div class="profile-card">
  <!-- 手机端：水平布局 | 桌面端：垂直布局 -->
  <div
    class="profile-inner p-4 sm:p-5 flex flex-row items-center gap-3 sm:flex-col sm:items-center text-left sm:text-center"
  >
    <div class="shrink-0 sm:mb-3">
      {
        avatar ? (
          <img
            src={avatar.src}
            alt={name}
            class={
              isLg
                ? 'w-16 h-16 sm:w-24 sm:h-24 rounded-full object-cover'
                : 'w-10 h-10 sm:w-16 sm:h-16 rounded-full object-cover'
            }
          />
        ) : (
          <div
            class={
              'avatar-fallback ' +
              (isLg
                ? 'w-16 h-16 sm:w-24 sm:h-24 rounded-full bg-[var(--surface-3)] text-[var(--text-muted)] flex items-center justify-center text-lg font-semibold'
                : 'w-10 h-10 sm:w-16 sm:h-16 rounded-full bg-[var(--surface-3)] text-[var(--text-muted)] flex items-center justify-center text-lg font-semibold')
            }
          >
            {name.replace('七月', '').charAt(0) || name.charAt(0)}
          </div>
        )
      }
    </div>
    <div class="flex-1 min-w-0">
      {
        isLg ? (
          <h2 class="text-[21px] font-semibold text-[var(--deep-text)]">{name}</h2>
        ) : (
          <h4 class="font-bold text-lg text-[var(--deep-text)]">{name}</h4>
        )
      }
      {role && <span class={isLg ? 'text-[var(--primary)] font-semibold' : 'text-xs text-[var(--text-muted)]'}>{role}</span>}
      {desc && <p class="text-xs text-[var(--text-muted)] mt-1">{desc}</p>}
      {dream && <p class="text-xs text-[var(--secondary)] mt-1 italic">{dream}</p>}
      {quote && <p class="profile-quote text-xs text-[var(--primary)]/70 mt-1">{quote}</p>}
    </div>
  </div>
</div>
