---
import Layout from './BaseLayout.astro';
import SiteNavbar from '~/features/shell-community/components/SiteNavbar.astro';
import Footer from '~/features/shell/components/Footer.astro';

import { navBarConfig } from '~/lib/config/fuwari-community';
import { footerData, filterNavbarByNames } from '~/lib/navigation';
import { LinkPresets } from '~/lib/constants/link-presets';
import { LinkPreset, type NavBarLink } from '~/types/config';
import type { MetaData } from '~/types/core';

export interface Props {
  metadata?: MetaData;
  navItems?: string[];
}

const { metadata, navItems } = Astro.props;

// community 模块顶栏：直接使用完整社区配置，由页面用 navItems 白名单挑选
const navbarLinks: NavBarLink[] = filterNavbarByNames(
  navBarConfig.links.map((item: NavBarLink | LinkPreset): NavBarLink => {
    if (typeof item === 'number') {
      return LinkPresets[item];
    }
    return item;
  }),
  navItems,
);
---

<Layout metadata={metadata} navbarLinks={navbarLinks}>
  <SiteNavbar links={navbarLinks} />
  <main>
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerData} />
  </slot>
</Layout>
