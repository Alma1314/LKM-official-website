---
import Layout from './BaseLayout.astro';
import SiteNavbar from '~/features/shell/components/SiteNavbar.astro';
import Footer from '~/features/shell/components/Footer.astro';

import { footerData } from '~/lib/navigation';

import type { MetaData } from '~/types/core';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;
---

<Layout metadata={metadata}>
  <SiteNavbar />
  <main>
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerData} />
  </slot>
</Layout>
