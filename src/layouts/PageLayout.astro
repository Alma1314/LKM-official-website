---
import Layout from './BaseLayout.astro';
import Navbar from '~/features/shell/components/FuwariNavbar.astro';
import Footer from '~/features/shell/components/Footer.astro';

import { footerData } from '~/core/navigation';

import type { MetaData } from '~/core/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;
---

<Layout metadata={metadata}>
  <slot name="header">
    <div class="sticky top-0 z-50 bg-card-bg">
      <Navbar />
    </div>
  </slot>
  <main>
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerData} />
  </slot>
</Layout>
