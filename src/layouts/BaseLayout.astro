---
import '~/core/styles/tailwind.css';
import '../styles/main.css';
import '../styles/variables.css';

import LoginPage from '~/features/auth/components/login/LoginPage.vue';
import { I18N } from '~/core/config';
import { siteConfig } from '~/core/config';
import CommonMeta from '~/features/shell/common/components/CommonMeta.astro';
import Favicons from '~/features/shell/components/Favicons.astro';
import CustomStyles from '~/features/shell/common/components/CustomStyles.astro';
import ApplyColorMode from '~/features/shell/common/components/ApplyColorMode.astro';
import Metadata from '~/features/shell/common/components/Metadata.astro';
import SiteVerification from '~/features/shell/common/components/SiteVerification.astro';
import Analytics from '~/features/shell/common/components/Analytics.astro';
import BasicScripts from '~/features/shell/common/components/BasicScripts.astro';
import MobileNavPanel from '~/features/shell/components/MobileNavPanel.astro';
import { navBarConfig } from '~/core/config';
import { LinkPresets } from '~/core/constants/link-presets';
import { LinkPreset, type NavBarLink } from '~/types/config';

// 注释下面这行以禁用 View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/core/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;
const baseUrl = import.meta.env.BASE_URL;

const navbarLinks: NavBarLink[] = navBarConfig.links.map((item: NavBarLink | LinkPreset): NavBarLink => {
  if (typeof item === 'number') {
    return LinkPresets[item];
  }
  return item;
});
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <script is:inline define:vars={{ configHue: siteConfig.themeColor.hue }}>
      // 在首次渲染前设置主题色相，避免颜色闪烁
      (function () {
        const hue = localStorage.getItem('hue') || configHue;
        document.documentElement.style.setProperty('--hue', hue);
      })();
    </script>
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    <link rel="preconnect" href="https://images.unsplash.com" />

    <!-- 注释下面这行以禁用 View Transitions -->
    <ClientRouter fallback="swap" />
    <script is:inline define:vars={{ baseUrl }}>
      window.__BASE_URL__ = baseUrl;
    </script>
  </head>

  <body class="antialiased text-default tracking-tight">
    <slot />

    <slot name="body-end" />
    <MobileNavPanel id="mobile-nav-fuwari" title="导航" links={navbarLinks} />

    <BasicScripts />

    <!-- 登录浮层 -->
    <div
      id="login-modal"
      class="fixed inset-0 z-[100] hidden items-center justify-center"
      role="dialog"
      aria-modal="true"
    >
      <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" data-login-close></div>
      <div id="login-modal-content" class="relative z-10 w-full max-w-md mx-4"></div>
    </div>

    <script is:inline>
      (function() {
        const modal = document.getElementById('login-modal');
        const content = document.getElementById('login-modal-content');
        if (!modal || !content) return;

        let loaded = false;
        async function open() {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          document.body.style.overflow = 'hidden';
          if (!loaded) {
            loaded = true;
            try {
              const resp = await fetch(window.__BASE_URL__ + 'login');
              const html = await resp.text();
              const parser = new DOMParser();
              const doc = parser.parseFromString(html, 'text/html');
              const card = doc.querySelector('.rounded-2xl.bg-card-bg.shadow-2xl');
              if (card) {
                // 追加关闭按钮
                const closeBtn = document.createElement('button');
                closeBtn.type = 'button';
                closeBtn.className = 'absolute top-4 right-4 btn btn-ghost btn-sm btn-circle';
                closeBtn.setAttribute('aria-label', '关闭');
                closeBtn.textContent = '✕';
                closeBtn.addEventListener('click', close);
                card.style.position = 'relative';
                card.appendChild(closeBtn);
                content.innerHTML = '';
                content.appendChild(card);
              }
            } catch {
              window.location.href = window.__BASE_URL__ + 'login';
            }
          }
        }

        function close() {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          document.body.style.overflow = '';
        }

        modal.querySelectorAll('[data-login-close]').forEach(el => {
          el.addEventListener('click', close);
        });

        modal.addEventListener('click', function(e) {
          if (e.target === modal) close();
        });

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && !modal.classList.contains('hidden')) close();
        });

        window.addEventListener('open-login-modal', open);
      })();
    </script>
  </body>
</html>
