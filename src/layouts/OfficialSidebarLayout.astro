---
import OfficialLayout from './OfficialLayout.astro';
import Sidebar from '~/features/homepage/widgets/Sidebar.astro';

import type { MetaData } from '~/core/types';

export interface SidebarLink {
  text: string;
  href: string;
  icon?: string;
}

export interface Props {
  metadata?: MetaData;
  sidebarLinks?: SidebarLink[];
  currentPath?: string;
}

const DEFAULT_ICON = 'tabler:link';
const { metadata, sidebarLinks = [], currentPath = '' } = Astro.props;
---

<OfficialLayout metadata={metadata}>
  {
    sidebarLinks.length > 0 && (
      <Sidebar
        groups={sidebarLinks.map(({ icon, ...rest }) => ({ ...rest, icon: icon ?? DEFAULT_ICON }))}
        currentPath={currentPath}
      />
    )
  }

  <div data-main-content>
    <div class="max-w-7xl mx-auto px-4 md:px-6 py-16 md:py-20 lg:py-24">
      <slot />
    </div>
  </div>
</OfficialLayout>
