---
import FuwariNavbar from './FuwariNavbar.astro';

interface Props {
  id?: string;
  class?: string;
}

const { id, class: className } = Astro.props;
const baseClasses = 'sticky top-0 z-50 bg-white dark:bg-[oklch(0.23_0.015_var(--hue))]';
const mergedClass = [baseClasses, className].filter(Boolean).join(' ');
---

<div id={id || 'navbar-wrapper'} class={mergedClass}>
  <FuwariNavbar />
</div>
