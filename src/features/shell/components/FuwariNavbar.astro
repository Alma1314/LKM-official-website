---
import { Icon } from 'astro-icon/components';
import { navBarConfig, siteConfig } from '~/core/config';
import { LinkPresets } from '~/core/constants/link-presets';
import { LinkPreset, type NavBarLink } from '~/types/config';
import { url } from '~/core/utils/url-utils';
import LightDarkSwitch from './LightDarkSwitch.svelte';
import Search from './Search.svelte';
import DisplaySettings from './widget/DisplaySettings.svelte';
import NavMenuPanel from '~/features/shell/components/NavMenuPanel.astro';

interface Props {
  class?: string;
  links?: NavBarLink[];
}

const className = Astro.props.class;

let links: NavBarLink[] =
  Astro.props.links ||
  navBarConfig.links.map((item: NavBarLink | LinkPreset): NavBarLink => {
    if (typeof item === 'number') {
      return LinkPresets[item];
    }
    return item;
  });

// 展平所有链接（含 children）给移动端 NavMenuPanel 使用
function flattenLinks(items: NavBarLink[]): NavBarLink[] {
  const result: NavBarLink[] = [];
  for (const item of items) {
    result.push({ name: item.name, url: item.url, external: item.external });
    if (item.children) {
      result.push(...flattenLinks(item.children));
    }
  }
  return result;
}

const mobileLinks = flattenLinks(links);
---

<div id="navbar" class="z-50 onload-animation">
  <div class="absolute h-8 left-0 right-0 -top-8 bg-card-bg transition"></div>
  <div
    class:list={[
      className,
      'card-base !overflow-visible h-[4.5rem] !rounded-t-none grid grid-cols-[1fr_auto_1fr] items-center px-4',
    ]}
  >
    <a href={url('/')} class="btn-plain scale-animation rounded-lg h-[3.25rem] px-5 font-bold active:scale-95 justify-self-start">
      <div class="flex flex-row text-primary items-center text-md">
        <Icon name="material-symbols:home-outline-rounded" class="text-[1.75rem] mb-1 mr-2" />
        {siteConfig.title}
      </div>
    </a>
    <div class="hidden md:flex" id="navbar-links">
    {
      links.map((l, idx) => {
        const hasChildren = l.children && l.children.length > 0;
        if (!hasChildren) {
          return (
            <a
              aria-label={l.name}
              href={l.external ? l.url : url(l.url)}
              target={l.external ? '_blank' : null}
              class="btn-plain scale-animation rounded-lg h-11 font-bold px-5 active:scale-95 flex items-center gap-1"
            >
              {l.name}
              {l.external && (
                <Icon
                  name="fa6-solid:arrow-up-right-from-square"
                  class="text-[0.875rem] -translate-y-[1px] text-black/[0.2] dark:text-white/[0.2]"
                />
              )}
            </a>
          );
        }
        return (
          <div class="relative dropdown" data-nav-dropdown={idx}>
            <button
              type="button"
              aria-label={l.name}
              class="btn-plain scale-animation rounded-lg h-11 font-bold px-5 active:scale-95 flex items-center gap-1"
              data-dropdown-trigger
            >
              {l.name}
              <Icon
                name="material-symbols:keyboard-arrow-down-rounded"
                class="text-[1rem] text-black/[0.3] dark:text-white/[0.3] transition-transform"
                data-dropdown-arrow
              />
            </button>
            <div class="absolute left-0 top-full pt-2 hidden z-50" data-dropdown-menu>
              <div class="card-base float-panel p-2">
                {l.children!.map((child) => (
                  <a
                    aria-label={child.name}
                    href={child.external ? child.url : url(child.url)}
                    target={child.external ? '_blank' : null}
                    class="flex transition whitespace-nowrap items-center !justify-start w-full btn-plain scale-animation rounded-lg h-9 px-3 font-medium active:scale-95 mb-0.5"
                  >
                    {child.name}
                  </a>
                ))}
              </div>
            </div>
          </div>
        );
      })
    }
    </div>
    <div class="flex justify-self-end">
      <Search client:only="svelte" />
      {
        !siteConfig.themeColor.fixed && (
          <button
            aria-label="Display Settings"
            class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90"
            id="display-settings-switch"
          >
            <Icon name="material-symbols:palette-outline" class="text-[1.25rem]" />
          </button>
        )
      }
      <LightDarkSwitch client:only="svelte" />
      <button
        aria-label="Menu"
        name="Nav Menu"
        class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden"
        id="nav-menu-switch"
      >
        <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]" />
      </button>
    </div>
    <NavMenuPanel links={mobileLinks} />
    <DisplaySettings client:only="svelte" />
  </div>
</div>

<script>
  function closeAllNavPopups() {
    document.querySelectorAll('[data-dropdown-menu]').forEach((m) => m.classList.add('hidden'));
    document.querySelectorAll('[data-dropdown-arrow]').forEach((a) => a.classList.remove('rotate-180'));
    const settingPanel = document.getElementById('display-setting');
    if (settingPanel) settingPanel.classList.add('float-panel-closed');
    const menuPanel = document.getElementById('nav-menu-panel');
    if (menuPanel) menuPanel.classList.add('float-panel-closed');
  }

  // 使用事件委托处理所有 navbar 交互，View Transitions 导航后无需重新绑定
  document.addEventListener('click', (e) => {
    const target = e.target;
    if (!(target instanceof HTMLElement)) return;

    // display-setting 按钮
    if (target.closest('#display-settings-switch')) {
      e.stopPropagation();
      const panel = document.getElementById('display-setting');
      if (!panel) return;
      const willOpen = panel.classList.contains('float-panel-closed');
      document.querySelectorAll('[data-dropdown-menu]').forEach((m) => m.classList.add('hidden'));
      document.querySelectorAll('[data-dropdown-arrow]').forEach((a) => a.classList.remove('rotate-180'));
      document.getElementById('nav-menu-panel')?.classList.add('float-panel-closed');
      if (willOpen) {
        panel.classList.remove('float-panel-closed');
      } else {
        panel.classList.add('float-panel-closed');
      }
      return;
    }

    // nav-menu 按钮
    if (target.closest('#nav-menu-switch')) {
      e.stopPropagation();
      const panel = document.getElementById('nav-menu-panel');
      if (!panel) return;
      const willOpen = panel.classList.contains('float-panel-closed');
      document.querySelectorAll('[data-dropdown-menu]').forEach((m) => m.classList.add('hidden'));
      document.querySelectorAll('[data-dropdown-arrow]').forEach((a) => a.classList.remove('rotate-180'));
      document.getElementById('display-setting')?.classList.add('float-panel-closed');
      if (willOpen) {
        panel.classList.remove('float-panel-closed');
      } else {
        panel.classList.add('float-panel-closed');
      }
      return;
    }

    // navbar dropdown 触发按钮
    const trigger = target.closest('[data-dropdown-trigger]');
    if (trigger) {
      const dropdown = trigger.closest('[data-nav-dropdown]');
      if (dropdown) {
        e.stopPropagation();
        const menu = dropdown.querySelector<HTMLElement>('[data-dropdown-menu]');
        const arrow = dropdown.querySelector('[data-dropdown-arrow]');
        if (menu) {
          const isOpen = !menu.classList.contains('hidden');
          closeAllNavPopups();
          if (!isOpen) {
            menu.classList.remove('hidden');
            if (arrow) arrow.classList.add('rotate-180');
          }
        }
        return;
      }
    }

    // 点击外部关闭所有
    closeAllNavPopups();
  });
</script>

{
  import.meta.env.PROD && (
    <script
      is:inline
      define:vars={{ scriptUrl: url('/pagefind/pagefind.js') }}
      set:html={`async function loadPagefind() {
    try {
        var response = await fetch('${url('/pagefind/pagefind.js')}', { method: 'HEAD' });
        if (!response.ok) {
            throw new Error('Pagefind script not found: ' + response.status);
        }
        var pagefind = await import('${url('/pagefind/pagefind.js')}');
        await pagefind.options({ excerptLength: 20 });
        window.pagefind = pagefind;
        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = { search: function() { return Promise.resolve({ results: [] }); }, options: function() { return Promise.resolve(); } };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}`}
    />
  )
}
