---
import type { OfficialArticle } from '~/lib/api/modules/official-articles';
import ArticleListItem from './ArticleListItem.astro';
import { t } from '~/lib/i18n';

interface Props {
  articles: OfficialArticle[];
  currentSlug: string;
  currentCategory?: string;
}

const { articles, currentSlug, currentCategory } = Astro.props;
const others = articles.filter((a) => a.slug !== currentSlug);
const related = [
  ...others.filter((a) => a.category === currentCategory),
  ...others.filter((a) => a.category !== currentCategory),
].slice(0, 4);
---

{
  related.length > 0 && (
    <section class="max-w-3xl mx-auto px-6 mt-16 border-t border-surface-3 pt-10">
      <h2 class="text-2xl font-bold mb-6 text-deep-text">{t('officialArticles.relatedPosts')}</h2>
      <ul>
        {related.map((article) => (
          <li class="mb-8">
            <ArticleListItem article={article} />
          </li>
        ))}
      </ul>
    </section>
  )
}
