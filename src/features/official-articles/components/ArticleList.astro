---
import Item from './ArticleListItem.astro';
import type { OfficialArticle } from '~/lib/api/modules/official-articles';

interface Props {
  articles?: OfficialArticle[];
  error?: string | null;
  emptyText?: string;
}

const { articles = [], error = null, emptyText = '暂无文章' } = Astro.props;
---

{
  (!articles || articles.length === 0) && (
    <p class="text-text-muted text-center py-8">{error ? `加载失败：${error}` : emptyText}</p>
  )
}

{
  articles.length > 0 && (
    <ul>
      {articles.map((article) => (
        <li class="mb-4 last:mb-0">
          <Item article={article} />
        </li>
      ))}
    </ul>
  )
}
