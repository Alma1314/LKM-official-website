---
import Item from './ArticleGridItem.astro';
import type { OfficialArticle } from '~/lib/api/modules/official-articles';

interface Props {
  articles: OfficialArticle[];
}

const { articles } = Astro.props;
---

<div class="grid gap-6 row-gap-5 md:grid-cols-2 lg:grid-cols-4 -mb-6">
  {articles.map((article) => <Item article={article} />)}
</div>
