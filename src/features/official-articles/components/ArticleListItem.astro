---
import { Icon } from 'astro-icon/components';
import Image from '~/components/primitives/Image.astro';
import type { OfficialArticle } from '~/lib/api/modules/official-articles';
import { categoryLabel } from '~/lib/api/modules/official-articles';
import { getPermalink } from '~/lib/utils/permalinks';
import { findImage } from '~/lib/utils/images';
import { getFormattedDate } from '~/lib/utils/utils';

interface Props {
  article: OfficialArticle;
}

const { article } = Astro.props;
const image = await findImage(article.cover);
const link = getPermalink(`/official/articles/${article.slug}`);
---

<article class={`max-w-md mx-auto md:max-w-none grid gap-6 md:gap-8 ${image ? 'md:grid-cols-2' : ''}`}>
  {
    image && (
      <a class="relative block group" href={link}>
        <div class="relative h-0 pb-[56.25%] md:pb-[75%] md:h-72 lg:pb-[56.25%] overflow-hidden bg-gray-400 dark:bg-slate-700 rounded shadow-lg">
          <Image
            src={image}
            class="absolute inset-0 object-cover w-full h-full mb-6 rounded shadow-lg bg-gray-400 dark:bg-slate-700"
            widths={[400, 900]}
            width={900}
            height={506}
            sizes="(max-width: 900px) 400px, 900px"
            alt={article.title}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </div>
      </a>
    )
  }
  <div class="mt-2">
    <header>
      <div class="mb-1">
        <span class="text-sm">
          <Icon name="tabler:clock" class="w-3.5 h-3.5 inline-block -mt-0.5 dark:text-gray-400" />
          <time datetime={article.published} class="inline-block">{getFormattedDate(new Date(article.published))}</time>
          {
            article.category && (
              <>
                {' '}
                ·{' '}
                <a class="hover:underline" href={getPermalink(`/official/articles/category/${article.category}`)}>
                  {categoryLabel(article.category)}
                </a>
              </>
            )
          }
        </span>
      </div>
      <h2 class="text-xl sm:text-2xl font-bold leading-tight mb-2 font-heading dark:text-slate-300">
        <a class="inline-block hover:text-primary dark:hover:text-blue-700 transition ease-in duration-200" href={link}>
          {article.title}
        </a>
      </h2>
    </header>

    {article.description && <p class="flex-grow text-muted dark:text-slate-400 text-lg">{article.description}</p>}
  </div>
</article>
