---
interface Props {
  keywords?: string[];
  class?: string;
}

const { keywords, class: className = 'text-sm' } = Astro.props;
---

{
  keywords && Array.isArray(keywords) && keywords.length > 0 && (
    <ul class={className}>
      {keywords.map((kw) => (
        <li class="bg-gray-100 dark:bg-slate-700 inline-block mr-2 rtl:mr-0 rtl:ml-2 mb-2 py-0.5 px-2 font-medium">
          {kw}
        </li>
      ))}
    </ul>
  )
}
