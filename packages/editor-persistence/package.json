{
  "name": "@lkm/editor-persistence",
  "version": "0.1.0",
  "description": "Local persistence adapter for @lkm/rich-text-editor",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@lkm/rich-text-editor": "workspace:*"
  },
  "devDependencies": {
    "@lkm/rich-text-editor": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
