{
  "name": "@lkm/rich-text-editor",
  "version": "0.1.0",
  "description": "MDX-powered rich text editor built on TipTap",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@tiptap/core": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@tiptap/extension-character-count": "^3.28.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/extension-table": "^3.28.0",
    "@tiptap/extension-table-cell": "^3.28.0",
    "@tiptap/extension-table-header": "^3.28.0",
    "@tiptap/extension-table-row": "^3.28.0",
    "@tiptap/extension-task-item": "^3.28.0",
    "@tiptap/extension-task-list": "^3.28.0",
    "@tiptap/extension-underline": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@chenglou/pretext": "^0.0.8",
    "katex": "^0.18.1",
    "sanitize-html": "^2.17.6",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "remark-mdx": "^3.1.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "js-yaml": "^4.1.0",
    "mdast-util-to-string": "^4.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "vitest": {
    "include": [
      "__tests__/**/*.test.ts"
    ]
  }
}
